{
  "manifest_version": 2,
  "name": "Zephium Firefox Probe",
  "version": "1.1",
  "description": "Checks Firefox-style add-ons on the Linux runtime.",
  "browser_specific_settings": {
    "gecko": {
      "id": "probe@zephium.test"
    }
  },
  "permissions": [
    "storage",
    "<all_urls>",
    "menus",
    "cookies",
    "tabs"
  ],
  "background": {
    "scripts": [
      "background.js"
    ]
  },
  "browser_action": {
    "default_title": "Firefox Probe"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "content.js"
      ]
    }
  ],
  "commands": {
    "probe-command": {
      "suggested_key": {
        "default": "Ctrl+Shift+Y"
      },
      "description": "Probe command"
    }
  }
}
