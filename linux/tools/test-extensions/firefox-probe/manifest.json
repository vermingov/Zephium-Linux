{
  "manifest_version": 2,
  "name": "Zephium Firefox Probe",
  "version": "1.0",
  "description": "Checks Firefox-style add-ons on the Linux runtime.",
  "browser_specific_settings": { "gecko": { "id": "probe@zephium.test" } },
  "permissions": ["storage", "<all_urls>"],
  "background": { "scripts": ["background.js"] },
  "browser_action": { "default_title": "Firefox Probe" },
  "content_scripts": [{ "matches": ["<all_urls>"], "js": ["content.js"] }]
}
