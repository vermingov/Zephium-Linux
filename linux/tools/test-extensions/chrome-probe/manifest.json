{
  "manifest_version": 3,
  "name": "Zephium Probe",
  "version": "1.0",
  "description": "Checks the Linux runtime: messaging, storage, badge, popup.",
  "permissions": ["storage", "scripting", "activeTab"],
  "host_permissions": ["<all_urls>"],
  "background": { "service_worker": "background.js" },
  "action": { "default_popup": "popup.html", "default_title": "Zephium Probe" },
  "content_scripts": [{ "matches": ["<all_urls>"], "js": ["content.js"], "run_at": "document_end" }]
}
