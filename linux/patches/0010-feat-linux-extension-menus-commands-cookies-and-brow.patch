+//! Extensions' keyboard commands (`commands` in the manifest): a key press
+//! in a tab that matches one raises `commands.onCommand` in the extension.
+//!
+//! The table is read on every key press, so it is kept ready: rebuilt when
+//! the installed extensions change, shared with each tab's key handler.
+
+use std::cell::RefCell;
+use std::rc::Rc;
+
+use gtk::gdk::ModifierType;
+use gtk::glib::translate::IntoGlib;
+use gtk::prelude::WidgetExt;
+use serde_json::{json, Value};
+use webkit2gtk::WebView;
+use zephium_core::ids::ProfileId;
+use zephium_webext::manifest::Manifest;
+
+use super::routing::{raise, Endpoint};
+
+/// Modifiers a shortcut may name; others (Num Lock…) are ignored.
+const MODIFIERS: ModifierType = ModifierType::CONTROL_MASK.union(ModifierType::MOD1_MASK).union(ModifierType::SHIFT_MASK);
+
+#[derive(Clone, Debug, PartialEq)]
+pub(super) struct Shortcut {
+    pub(super) extension_id: String,
+    pub(super) command: String,
+    modifiers: ModifierType,
+    key: u32,
+}
+
+/// The profile's shortcuts, shared with the tabs' key handlers.
+pub(super) type Shortcuts = Rc<RefCell<Vec<Shortcut>>>;
+
+/// `"Alt+Shift+U"` as modifiers and a lower-case key value. `None` for what
+/// Linux cannot press (`MacCtrl`, `Command`) or does not know.
+fn parse(text: &str) -> Option<(ModifierType, u32)> {
+    let mut modifiers = ModifierType::empty();
+    let mut key = None;
+    for part in text.split('+').map(str::trim) {
+        match part {
+            "Ctrl" => modifiers |= ModifierType::CONTROL_MASK,
+            "Alt" => modifiers |= ModifierType::MOD1_MASK,
+            "Shift" => modifiers |= ModifierType::SHIFT_MASK,
+            "MacCtrl" | "Command" | "Search" => return None,
+            name => key = Some(key_value(name)?),
+        }
+    }
+    Some((modifiers, key?))
+}
+
+fn key_value(name: &str) -> Option<u32> {
+    let gdk_name = match name {
+        "Comma" => "comma",
+        "Period" => "period",
+        "Space" => "space",
+        "Insert" => "Insert",
+        "Delete" => "Delete",
+        "Home" => "Home",
+        "End" => "End",
+        "PageUp" => "Page_Up",
+        "PageDown" => "Page_Down",
+        "Up" | "Down" | "Left" | "Right" => name,
+        "MediaNextTrack" => "AudioNext",
+        "MediaPrevTrack" => "AudioPrev",
+        "MediaPlayPause" => "AudioPlay",
+        "MediaStop" => "AudioStop",
+        single if single.chars().count() == 1 => return single.chars().next().filter(char::is_ascii_alphanumeric).map(|key| key.to_ascii_lowercase() as u32),
+        function if function.starts_with('F') && function[1..].parse::<u8>().is_ok_and(|number| (1..=12).contains(&number)) => function,
+        _ => return None,
+    };
+    Some(gtk::gdk::keys::Key::from_name(gdk_name).into_glib())
+}
+
+/// The manifest's commands that have a key on Linux.
+pub(super) fn shortcuts(extension_id: &str, manifest: &Manifest) -> Vec<Shortcut> {
+    let Some(commands) = manifest.raw()["commands"].as_object() else {
+        return Vec::new();
+    };
+    commands
+        .iter()
+        .filter_map(|(command, details)| {
+            let key = details["suggested_key"]["linux"].as_str().or(details["suggested_key"]["default"].as_str())?;
+            let (modifiers, key) = parse(key)?;
+            Some(Shortcut { extension_id: extension_id.to_owned(), command: command.clone(), modifiers, key })
+        })
+        .collect()
+}
+
+/// Watch `view`'s key presses for the profile's shortcuts.
+pub(super) fn listen(view: &WebView, profile: ProfileId, shortcuts: Shortcuts) {
+    view.connect_key_press_event(move |view, event| {
+        let modifiers = event.state() & MODIFIERS;
+        let key = event.keyval().to_lower().into_glib();
+        let hit = shortcuts.borrow().iter().find(|shortcut| shortcut.modifiers == modifiers && shortcut.key == key).cloned();
+        let Some(hit) = hit else {
+            return gtk::glib::Propagation::Proceed;
+        };
+        let view = view.clone();
+        super::super::dispatch::best_effort_with(move |host| host.linux_command(profile, &view, hit));
+        gtk::glib::Propagation::Stop
+    });
+}
+
+impl super::super::EngineHost {
+    fn linux_command(&mut self, profile: ProfileId, view: &WebView, shortcut: Shortcut) {
+        let tab = self.linux_tab_of_view(profile, view).and_then(|item| {
+            let number = self.linux_extensions.profiles.get_mut(&profile)?.routing.tabs.number(item);
+            self.linux_all_tabs(profile).into_iter().find(|tab| tab["id"] == number)
+        });
+        let Some(install) = self.linux_extensions.profiles.get(&profile).and_then(|state| state.install(&shortcut.extension_id)) else {
+            return;
+        };
+        super::trace!("{} command {}", shortcut.extension_id, shortcut.command);
+        for view in install.own_views() {
+            raise(&Endpoint { view, frame: 0 }, &shortcut.extension_id, "commands.onCommand", json!([shortcut.command, tab.clone().unwrap_or(Value::Null)]));
+        }
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn manifest_keys_read_as_firefox_and_chrome_write_them() {
+        let (modifiers, key) = parse("Alt+Shift+U").unwrap();
+        assert_eq!(modifiers, ModifierType::MOD1_MASK | ModifierType::SHIFT_MASK);
+        assert_eq!(key, 'u' as u32);
+        assert_eq!(parse("Ctrl+Comma").map(|(_, key)| key), Some(gtk::gdk::keys::constants::comma.into_glib()));
+        assert!(parse("Ctrl+F5").is_some());
+        assert!(parse("MacCtrl+Shift+Y").is_none());
+        assert!(parse("Ctrl+Shift+F13").is_none());
+    }
+}
diff --git a/crates/zephium-engine/src/host/webext_linux/cookies.rs b/crates/zephium-engine/src/host/webext_linux/cookies.rs
new file mode 100644
index 00000000..ec9aa6c2
--- /dev/null
+++ b/crates/zephium-engine/src/host/webext_linux/cookies.rs
@@ -0,0 +1,253 @@
+//! `cookies`: the profile's cookies, through WebKit's cookie manager, for an
+//! extension with the `cookies` permission and host access to each cookie's
+//! site. One cookie store per profile, as Chrome has outside private windows.
+
+use std::ffi::{c_void, CString};
+
+use gtk::glib::translate::{FromGlibPtrContainer, ToGlibPtr};
+use serde_json::{json, Value};
+use webkit2gtk::{CookieManager, CookieManagerExt, WebContextExt, WebsiteDataManagerExt};
+use zephium_core::ids::ProfileId;
+use zephium_webext_process::matching::any_matches;
+
+use super::routing::{error, ok};
+use crate::platform::imp::extension_channel::Message;
+
+/// Chrome's one store outside private windows.
+const STORE_ID: &str = "0";
+
+// `get_all_cookies` (WebKitGTK 2.42) has no binding yet.
+unsafe extern "C" {
+    fn webkit_cookie_manager_get_all_cookies(
+        manager: *mut webkit2gtk::ffi::WebKitCookieManager,
+        cancellable: *mut c_void,
+        callback: gtk::gio::ffi::GAsyncReadyCallback,
+        user_data: *mut c_void,
+    );
+    fn webkit_cookie_manager_get_all_cookies_finish(
+        manager: *mut webkit2gtk::ffi::WebKitCookieManager,
+        result: *mut gtk::gio::ffi::GAsyncResult,
+        error: *mut *mut gtk::glib::ffi::GError,
+    ) -> *mut gtk::glib::ffi::GList;
+}
+
+type Cookies = Box<dyn FnOnce(Vec<soup::Cookie>)>;
+
+/// The cookies WebKit would send to `url`, or every cookie with no URL.
+fn read(manager: &CookieManager, url: Option<&str>, done: impl FnOnce(Vec<soup::Cookie>) + 'static) {
+    let done: *mut Cookies = Box::into_raw(Box::new(Box::new(done)));
+    let raw: *mut webkit2gtk::ffi::WebKitCookieManager = manager.to_glib_none().0;
+    // SAFETY: the box goes to exactly one callback, which takes it back.
+    unsafe {
+        match url.and_then(|url| CString::new(url).ok()) {
+            Some(url) => webkit2gtk::ffi::webkit_cookie_manager_get_cookies(raw, url.as_ptr(), std::ptr::null_mut(), Some(read_some), done.cast()),
+            None => webkit_cookie_manager_get_all_cookies(raw, std::ptr::null_mut(), Some(read_all), done.cast()),
+        }
+    }
+}
+
+unsafe extern "C" fn read_some(source: *mut gtk::glib::gobject_ffi::GObject, result: *mut gtk::gio::ffi::GAsyncResult, data: *mut c_void) {
+    let list = webkit2gtk::ffi::webkit_cookie_manager_get_cookies_finish(source.cast(), result, std::ptr::null_mut());
+    deliver(list, data);
+}
+
+unsafe extern "C" fn read_all(source: *mut gtk::glib::gobject_ffi::GObject, result: *mut gtk::gio::ffi::GAsyncResult, data: *mut c_void) {
+    let list = webkit_cookie_manager_get_all_cookies_finish(source.cast(), result, std::ptr::null_mut());
+    deliver(list, data);
+}
+
+unsafe fn deliver(list: *mut gtk::glib::ffi::GList, data: *mut c_void) {
+    let done = Box::from_raw(data.cast::<Cookies>());
+    // SAFETY: both calls hand over the list and its cookies.
+    let cookies: Vec<soup::Cookie> = FromGlibPtrContainer::<*mut soup::ffi::SoupCookie, *mut gtk::glib::ffi::GList>::from_glib_full(list);
+    done(cookies);
+}
+
+/// A cookie as the API gives it.
+fn describe(cookie: &mut soup::Cookie) -> Value {
+    let domain = cookie.domain().map(|domain| domain.to_string()).unwrap_or_default();
+    let expires = cookie.expires().map(|date| date.to_unix());
+    let same_site = match cookie.same_site_policy() {
+        soup::SameSitePolicy::Lax => "lax",
+        soup::SameSitePolicy::Strict => "strict",
+        soup::SameSitePolicy::None => "no_restriction",
+        _ => "unspecified",
+    };
+    let mut value = json!({
+        "name": cookie.name().map(|name| name.to_string()).unwrap_or_default(),
+        "value": cookie.value().map(|value| value.to_string()).unwrap_or_default(),
+        "domain": domain,
+        "hostOnly": !domain.starts_with('.'),
+        "path": cookie.path().map(|path| path.to_string()).unwrap_or_else(|| "/".into()),
+        "secure": cookie.is_secure(),
+        "httpOnly": cookie.is_http_only(),
+        "sameSite": same_site,
+        "session": expires.is_none(),
+        "storeId": STORE_ID,
+    });
+    if let Some(expires) = expires {
+        value["expirationDate"] = json!(expires);
+    }
+    value
+}
+
+/// The `https://` address of a cookie's site, to check host access against.
+fn site_of(cookie: &Value) -> String {
+    let host = cookie["domain"].as_str().unwrap_or_default().trim_start_matches('.');
+    format!("https://{host}/")
+}
+
+/// Whether `cookie` is on `domain` or one of its subdomains, as `getAll`
+/// filters.
+fn on_domain(cookie: &Value, domain: &str) -> bool {
+    let host = cookie["domain"].as_str().unwrap_or_default().trim_start_matches('.');
+    let domain = domain.trim_start_matches('.');
+    host == domain || host.ends_with(&format!(".{domain}"))
+}
+
+/// The policy `cookies.set` asks for; `None` keeps libsoup's Lax, as Chrome
+/// treats an unspecified one. libsoup drops a SameSite=None cookie without
+/// Secure, and Chrome refuses it.
+fn same_site(details: &Value) -> Result<Option<soup::SameSitePolicy>, &'static str> {
+    match details["sameSite"].as_str() {
+        Some("strict") => Ok(Some(soup::SameSitePolicy::Strict)),
+        Some("lax") => Ok(Some(soup::SameSitePolicy::Lax)),
+        Some("no_restriction") if details["secure"] != true => Err("A cookie with sameSite \"no_restriction\" must be secure."),
+        Some("no_restriction") => Ok(Some(soup::SameSitePolicy::None)),
+        _ => Ok(None),
+    }
+}
+
+fn matches_filter(cookie: &Value, filter: &Value) -> bool {
+    filter["name"].as_str().is_none_or(|name| cookie["name"] == name)
+        && filter["domain"].as_str().is_none_or(|domain| on_domain(cookie, domain))
+        && filter["path"].as_str().is_none_or(|path| cookie["path"] == path)
+        && filter["secure"].as_bool().is_none_or(|secure| cookie["secure"] == secure)
+        && filter["session"].as_bool().is_none_or(|session| cookie["session"] == session)
+}
+
+impl super::super::EngineHost {
+    /// Answers `message` once WebKit has the cookies.
+    pub(super) fn linux_cookies(&mut self, profile: ProfileId, message: Message, id: u64, method: &str, args: &[Value]) {
+        let details = args.first().cloned().unwrap_or(Value::Null);
+        let prepared = (|| {
+            let state = self.linux_extensions.profiles.get(&profile).ok_or("The extension is not running.")?;
+            let install = state.install(&message.extension_id).ok_or("The extension is not running.")?;
+            if !install.permissions.iter().any(|permission| permission == "cookies") {
+                return Err("The extension has no permission to read cookies.".to_owned());
+            }
+            let manager = state
+                .context
+                .as_ref()
+                .and_then(|context| context.website_data_manager())
+                .and_then(|data| data.cookie_manager())
+                .ok_or("The profile has no cookie store yet.")?;
+            Ok((manager, install.hosts.clone()))
+        })();
+        let (manager, hosts) = match prepared {
+            Ok(prepared) => prepared,
+            Err(reason) => return message.reply(&error(id, &reason)),
+        };
+        let url = details["url"].as_str().map(str::to_owned);
+        if let Some(url) = &url {
+            if !any_matches(&hosts, url) {
+                return message.reply(&error(id, &format!("No host permissions for cookies at url: \"{url}\".")));
+            }
+        }
+        match method {
+            "getAllCookieStores" => {
+                let tabs: Vec<Value> = self.linux_all_tabs(profile).into_iter().map(|tab| tab["id"].clone()).collect();
+                message.reply(&ok(id, json!([{ "id": STORE_ID, "tabIds": tabs }])))
+            }
+            "get" | "getAll" => {
+                let single = method == "get";
+                read(&manager, url.as_deref(), move |mut cookies| {
+                    let found: Vec<Value> = cookies
+                        .iter_mut()
+                        .map(describe)
+                        .filter(|cookie| any_matches(&hosts, &site_of(cookie)) && matches_filter(cookie, &details))
+                        .collect();
+                    if single {
+                        message.reply(&ok(id, found.into_iter().next().unwrap_or(Value::Null)));
+                    } else {
+                        message.reply(&ok(id, Value::Array(found)));
+                    }
+                });
+            }
+            "set" => {
+                let Some(url) = url else {
+                    return message.reply(&error(id, "cookies.set needs a url."));
+                };
+                let Ok(parsed) = url::Url::parse(&url) else {
+                    return message.reply(&error(id, "The url is not valid."));
+                };
+                let domain = details["domain"].as_str().map(str::to_owned).unwrap_or_else(|| parsed.host_str().unwrap_or_default().to_owned());
+                let path = details["path"].as_str().unwrap_or("/");
+                let mut cookie = soup::Cookie::new(
+                    details["name"].as_str().unwrap_or_default(),
+                    details["value"].as_str().unwrap_or_default(),
+                    &domain,
+                    path,
+                    -1,
+                );
+                cookie.set_secure(details["secure"] == true);
+                cookie.set_http_only(details["httpOnly"] == true);
+                match same_site(&details) {
+                    Ok(Some(policy)) => cookie.set_same_site_policy(policy),
+                    Ok(None) => {}
+                    Err(reason) => return message.reply(&error(id, reason)),
+                }
+                if let Some(expires) = details["expirationDate"].as_f64().and_then(|seconds| gtk::glib::DateTime::from_unix_utc(seconds as i64).ok()) {
+                    cookie.set_expires(&expires);
+                }
+                let answer = describe(&mut cookie.clone());
+                manager.add_cookie(&mut cookie, None::<&gtk::gio::Cancellable>, move |result| match result {
+                    Ok(()) => message.reply(&ok(id, answer)),
+                    Err(failure) => message.reply(&error(id, &failure.to_string())),
+                });
+            }
+            "remove" => {
+                let Some(url) = url else {
+                    return message.reply(&error(id, "cookies.remove needs a url."));
+                };
+                let name = details["name"].as_str().unwrap_or_default().to_owned();
+                let deleting = manager.clone();
+                read(&manager, Some(&url.clone()), move |cookies| {
+                    let mut target = cookies.into_iter().find(|cookie| cookie.clone().name().is_some_and(|found| found == name.as_str()));
+                    let Some(mut cookie) = target.take() else {
+                        return message.reply(&ok(id, Value::Null));
+                    };
+                    deleting.delete_cookie(&mut cookie, None::<&gtk::gio::Cancellable>, move |_| {
+                        message.reply(&ok(id, json!({ "url": url, "name": name, "storeId": STORE_ID })));
+                    });
+                });
+            }
+            _ => message.reply(&error(id, &format!("cookies.{method} is not available on Linux yet."))),
+        }
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn filters_read_as_chrome_documents_them() {
+        let cookie = json!({ "name": "sid", "domain": ".example.com", "path": "/", "secure": true, "session": false });
+        assert!(matches_filter(&cookie, &json!({ "domain": "example.com" })));
+        assert!(matches_filter(&cookie, &json!({ "domain": "www.example.com" })) == false);
+        assert!(on_domain(&json!({ "domain": "a.example.com" }), "example.com"));
+        assert!(!on_domain(&json!({ "domain": "badexample.com" }), "example.com"));
+        assert!(matches_filter(&cookie, &json!({ "name": "sid", "secure": true })));
+        assert!(!matches_filter(&cookie, &json!({ "session": true })));
+        assert_eq!(site_of(&cookie), "https://example.com/");
+    }
+
+    #[test]
+    fn same_site_keeps_what_libsoup_stores() {
+        assert_eq!(same_site(&json!({ "url": "https://example.com/" })), Ok(None));
+        assert_eq!(same_site(&json!({ "sameSite": "strict" })), Ok(Some(soup::SameSitePolicy::Strict)));
+        assert!(same_site(&json!({ "sameSite": "no_restriction" })).is_err());
+        assert_eq!(same_site(&json!({ "sameSite": "no_restriction", "secure": true })), Ok(Some(soup::SameSitePolicy::None)));
+    }
+}
diff --git a/crates/zephium-engine/src/host/webext_linux/menus.rs b/crates/zephium-engine/src/host/webext_linux/menus.rs
new file mode 100644
index 00000000..1847583b
--- /dev/null
+++ b/crates/zephium-engine/src/host/webext_linux/menus.rs
@@ -0,0 +1,329 @@
+//! `menus` / `contextMenus`: items extensions add to a page's context menu.
+//!
+//! An extension's items are kept with it; a shared table of every
+//! extension's items is read when a tab's menu opens, and the matching ones
+//! are appended to WebKit's own menu, under the extension's name when it
+//! has more than one. A click raises `menus.onClicked` in the extension.
+
+use std::cell::RefCell;
+use std::rc::Rc;
+
+use serde_json::{json, Map, Value};
+use webkit2gtk::{ContextMenu, ContextMenuExt, ContextMenuItem, HitTestResult, HitTestResultExt, WebView, WebViewExt};
+use zephium_core::ids::ProfileId;
+use zephium_webext_process::matching::any_matches;
+
+use super::routing::{raise, Endpoint};
+
+/// Chrome's limit on items per extension.
+const MAX_ITEMS: usize = 1000;
+
+#[derive(Default)]
+pub(super) struct Menus {
+    items: Vec<Value>,
+}
+
+/// One extension's items, as the tabs read them.
+#[derive(Clone)]
+pub(super) struct ExtensionMenu {
+    pub(super) extension_id: String,
+    pub(super) name: String,
+    pub(super) items: Vec<Value>,
+}
+
+pub(super) type MenuTable = Rc<RefCell<Vec<ExtensionMenu>>>;
+
+impl Menus {
+    pub(super) fn items(&self) -> &[Value] {
+        &self.items
+    }
+
+    fn call(&mut self, method: &str, args: &[Value]) -> Result<Value, String> {
+        match method {
+            "create" => {
+                let item = args.first().cloned().filter(Value::is_object).ok_or("menus.create takes an object.")?;
+                let id = item["id"].clone();
+                if self.items.iter().any(|existing| existing["id"] == id) {
+                    return Err(format!("Cannot create item with duplicate id {id}"));
+                }
+                if self.items.len() >= MAX_ITEMS {
+                    return Err("Too many menu items.".into());
+                }
+                self.items.push(item);
+                Ok(id)
+            }
+            "update" => {
+                let id = args.first().cloned().unwrap_or(Value::Null);
+                let changes = args.get(1).and_then(Value::as_object).cloned().unwrap_or_default();
+                let item = self.items.iter_mut().find(|item| item["id"] == id).ok_or(format!("Cannot find menu item with id {id}"))?;
+                for (key, value) in changes {
+                    item[key] = value;
+                }
+                Ok(Value::Null)
+            }
+            "remove" => {
+                let id = args.first().cloned().unwrap_or(Value::Null);
+                let before = self.items.len();
+                // An item's children go with it.
+                let mut gone = vec![id.clone()];
+                while let Some(parent) = gone.pop() {
+                    let children: Vec<Value> = self.items.iter().filter(|item| item["parentId"] == parent).map(|item| item["id"].clone()).collect();
+                    self.items.retain(|item| item["id"] != parent);
+                    gone.extend(children);
+                }
+                if self.items.len() == before {
+                    return Err(format!("Cannot find menu item with id {id}"));
+                }
+                Ok(Value::Null)
+            }
+            "removeAll" => {
+                self.items.clear();
+                Ok(Value::Null)
+            }
+            "refresh" => Ok(Value::Null),
+            _ => Err(format!("menus.{method} is not available on Linux yet.")),
+        }
+    }
+}
+
+/// What was right-clicked, in the menus API's terms.
+struct Target {
+    contexts: Vec<&'static str>,
+    page_url: String,
+    link_url: Option<String>,
+    src_url: Option<String>,
+    editable: bool,
+}
+
+fn target(view: &WebView, hit: &HitTestResult) -> Target {
+    let mut contexts = vec!["all"];
+    if hit.context_is_link() {
+        contexts.push("link");
+    }
+    if hit.context_is_image() {
+        contexts.push("image");
+    }
+    if hit.context_is_media() {
+        contexts.extend(["video", "audio"]);
+    }
+    if hit.context_is_selection() {
+        contexts.push("selection");
+    }
+    if hit.context_is_editable() {
+        contexts.push("editable");
+    }
+    if contexts.len() == 1 {
+        contexts.push("page");
+    }
+    Target {
+        contexts,
+        page_url: view.uri().map(|uri| uri.to_string()).unwrap_or_default(),
+        link_url: hit.link_uri().map(|uri| uri.to_string()),
+        src_url: hit.image_uri().or_else(|| hit.media_uri()).map(|uri| uri.to_string()),
+        editable: hit.context_is_editable(),
+    }
+}
+
+fn strings(value: &Value) -> Vec<String> {
+    value.as_array().map(|list| list.iter().filter_map(|item| item.as_str().map(str::to_owned)).collect()).unwrap_or_default()
+}
+
+/// Whether `item` shows for `target`.
+fn shows(item: &Value, target: &Target) -> bool {
+    if item["visible"] == false {
+        return false;
+    }
+    let contexts = strings(&item["contexts"]);
+    let contexts = if contexts.is_empty() { vec!["page".to_owned()] } else { contexts };
+    if !contexts.iter().any(|context| target.contexts.contains(&context.as_str())) {
+        return false;
+    }
+    let documents = strings(&item["documentUrlPatterns"]);
+    if !documents.is_empty() && !any_matches(&documents, &target.page_url) {
+        return false;
+    }
+    let targets = strings(&item["targetUrlPatterns"]);
+    let target_url = target.link_url.as_deref().or(target.src_url.as_deref());
+    targets.is_empty() || target_url.is_some_and(|url| any_matches(&targets, url))
+}
+
+/// Watch `view`'s context menu for the profile's extension items.
+pub(super) fn listen(view: &WebView, profile: ProfileId, table: MenuTable) {
+    view.connect_context_menu(move |view, menu, _event, hit| {
+        let target = target(view, hit);
+        let extensions: Vec<ExtensionMenu> = table.borrow().clone();
+        let mut first = true;
+        for extension in extensions {
+            let top: Vec<&Value> =
+                extension.items.iter().filter(|item| item["parentId"].is_null() && shows(item, &target)).collect();
+            if top.is_empty() {
+                continue;
+            }
+            if first {
+                menu.append(&ContextMenuItem::new_separator());
+                first = false;
+            }
+            let entries = Entries { view, profile, extension: &extension, target: &target };
+            if top.len() == 1 && !has_children(&extension.items, &top[0]["id"]) {
+                menu.append(&entries.item(top[0]));
+            } else {
+                let submenu = ContextMenu::new();
+                for item in top {
+                    submenu.append(&entries.item(item));
+                }
+                menu.append(&ContextMenuItem::with_submenu(&extension.name, &submenu));
+            }
+        }
+        false
+    });
+}
+
+fn has_children(items: &[Value], id: &Value) -> bool {
+    items.iter().any(|item| &item["parentId"] == id)
+}
+
+struct Entries<'a> {
+    view: &'a WebView,
+    profile: ProfileId,
+    extension: &'a ExtensionMenu,
+    target: &'a Target,
+}
+
+impl Entries<'_> {
+    fn item(&self, item: &Value) -> ContextMenuItem {
+        if item["type"] == "separator" {
+            return ContextMenuItem::new_separator();
+        }
+        let mut title = item["title"].as_str().unwrap_or_default().replace("%s", "…");
+        if item["type"] == "checkbox" || item["type"] == "radio" {
+            title = format!("{} {title}", if item["checked"] == true { "✓" } else { "  " });
+        }
+        let children: Vec<&Value> =
+            self.extension.items.iter().filter(|child| child["parentId"] == item["id"] && shows(child, self.target)).collect();
+        if !children.is_empty() {
+            let submenu = ContextMenu::new();
+            for child in children {
+                submenu.append(&self.item(child));
+            }
+            return ContextMenuItem::with_submenu(&title, &submenu);
+        }
+        let action = gtk::gio::SimpleAction::new("zephium-extension-menu", None);
+        action.set_enabled(item["enabled"] != false);
+        let info = self.info(item);
+        let (view, profile, extension_id) = (self.view.clone(), self.profile, self.extension.extension_id.clone());
+        action.connect_activate(move |_, _| {
+            let (view, info, extension_id) = (view.clone(), info.clone(), extension_id.clone());
+            super::super::dispatch::best_effort_with(move |host| host.linux_menu_clicked(profile, &view, &extension_id, info));
+        });
+        ContextMenuItem::from_gaction(&action, &title, None)
+    }
+
+    /// `menus.OnClickData` for `item`, but for the selection, read on click.
+    fn info(&self, item: &Value) -> Value {
+        let mut info = Map::new();
+        info.insert("menuItemId".into(), item["id"].clone());
+        if !item["parentId"].is_null() {
+            info.insert("parentMenuItemId".into(), item["parentId"].clone());
+        }
+        info.insert("pageUrl".into(), json!(self.target.page_url));
+        info.insert("frameId".into(), json!(0));
+        info.insert("editable".into(), json!(self.target.editable));
+        if let Some(link) = &self.target.link_url {
+            info.insert("linkUrl".into(), json!(link));
+        }
+        if let Some(source) = &self.target.src_url {
+            info.insert("srcUrl".into(), json!(source));
+            let kind = if self.target.contexts.contains(&"image") { "image" } else { "video" };
+            info.insert("mediaType".into(), json!(kind));
+        }
+        if item["type"] == "checkbox" {
+            info.insert("wasChecked".into(), json!(item["checked"] == true));
+            info.insert("checked".into(), json!(item["checked"] != true));
+        }
+        Value::Object(info)
+    }
+}
+
+impl super::super::EngineHost {
+    pub(super) fn linux_menus(&mut self, profile: ProfileId, extension_id: &str, method: &str, args: &[Value]) -> Result<Value, String> {
+        let install = self
+            .linux_extensions
+            .profiles
+            .get_mut(&profile)
+            .and_then(|state| state.install_mut(extension_id))
+            .ok_or("The extension is not running.")?;
+        let answer = install.menus.call(method, args)?;
+        self.linux_menu_table_refresh(profile);
+        Ok(answer)
+    }
+
+    fn linux_menu_clicked(&mut self, profile: ProfileId, view: &WebView, extension_id: &str, mut info: Value) {
+        let tab = self.linux_tab_of_view(profile, view).and_then(|item| {
+            let number = self.linux_extensions.profiles.get_mut(&profile)?.routing.tabs.number(item);
+            self.linux_all_tabs(profile).into_iter().find(|tab| tab["id"] == number)
+        });
+        // A checkbox's new state is kept, as the browser keeps it.
+        if let Some(install) = self.linux_extensions.profiles.get_mut(&profile).and_then(|state| state.install_mut(extension_id)) {
+            if let Some(checked) = info["checked"].as_bool() {
+                let _ = install.menus.call("update", &[info["menuItemId"].clone(), json!({ "checked": checked })]);
+            }
+        }
+        self.linux_menu_table_refresh(profile);
+        let Some(views) = self.linux_extensions.profiles.get(&profile).and_then(|state| state.install(extension_id)).map(super::Install::own_views) else {
+            return;
+        };
+        let extension_id = extension_id.to_owned();
+        // The selection is the page's, read now from a world of its own.
+        view.evaluate_javascript("String(getSelection())", Some("zephium-menus"), None, None::<&gtk::gio::Cancellable>, move |result| {
+            let selection = result.ok().and_then(|value| super::action::js_string(&value)).unwrap_or_default();
+            if !selection.is_empty() {
+                info["selectionText"] = json!(selection);
+            }
+            for view in views {
+                raise(&Endpoint { view, frame: 0 }, &extension_id, "contextMenus.onClicked", json!([info.clone(), tab.clone().unwrap_or(Value::Null)]));
+            }
+        });
+    }
+
+    /// Every installed extension's items, as the tabs read them.
+    pub(super) fn linux_menu_table_refresh(&mut self, profile: ProfileId) {
+        let Some(state) = self.linux_extensions.profiles.get(&profile) else {
+            return;
+        };
+        *state.menus.borrow_mut() = state
+            .installs
+            .values()
+            .filter(|install| !install.menus.items().is_empty())
+            .map(|install| ExtensionMenu { extension_id: install.extension_id.clone(), name: install.loaded.name.clone(), items: install.menus.items().to_vec() })
+            .collect();
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    fn page() -> Target {
+        Target { contexts: vec!["all", "page"], page_url: "https://x.test/".into(), link_url: None, src_url: None, editable: false }
+    }
+
+    #[test]
+    fn items_show_in_their_contexts_only() {
+        assert!(shows(&json!({ "id": "a", "title": "A" }), &page()));
+        assert!(!shows(&json!({ "id": "a", "contexts": ["link"] }), &page()));
+        assert!(shows(&json!({ "id": "a", "contexts": ["all"] }), &page()));
+        assert!(!shows(&json!({ "id": "a", "visible": false }), &page()));
+        assert!(!shows(&json!({ "id": "a", "documentUrlPatterns": ["https://y.test/*"] }), &page()));
+    }
+
+    #[test]
+    fn removing_an_item_removes_its_children() {
+        let mut menus = Menus::default();
+        menus.call("create", &[json!({ "id": "parent" })]).unwrap();
+        menus.call("create", &[json!({ "id": "child", "parentId": "parent" })]).unwrap();
+        menus.call("create", &[json!({ "id": "other" })]).unwrap();
+        assert!(menus.call("create", &[json!({ "id": "other" })]).is_err());
+        menus.call("remove", &[json!("parent")]).unwrap();
+        assert_eq!(menus.items().len(), 1);
+    }
+}
