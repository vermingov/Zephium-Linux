+//! Toolbar actions: what each extension's button shows, and what clicking it
+//! does, opening its popup in a popover or raising `action.onClicked`.
+
+use std::collections::hash_map::DefaultHasher;
+use std::collections::HashMap;
+use std::hash::{Hash, Hasher};
+use std::path::Path;
+
+use gtk::prelude::*;
+use serde_json::{json, Value};
+use webkit2gtk::{WebView, WebViewExt};
+use zephium_core::extensions::{
+    ExtensionActionIcon, ExtensionActionRejection, ExtensionActionRequest, ExtensionActionRevision, ExtensionActionScope,
+    ExtensionActionSettlement, ExtensionActionSnapshot, ExtensionActionSnapshotSettlement, ExtensionActionState,
+    ExtensionBrowserSurfaceGeneration, ExtensionRuntimeInstance,
+};
+use zephium_core::geometry::Size;
+use zephium_core::ids::{ItemId, ProfileId};
+use zephium_core::ports::engine::EngineEvent;
+use zephium_webext::manifest::Manifest;
+
+use super::routing::{raise, Endpoint};
+use crate::platform::imp::extension_channel;
+
+/// The popup's size until its page says otherwise.
+const POPUP_SIZE: (i32, i32) = (380, 520);
+const ICON_SIZE: i32 = 32;
+
+/// One extension's toolbar action. Each property has a default and per-tab
+/// overrides, keyed by Chrome's tab number, as `action.set*({tabId})` sets them.
+pub(super) struct ActionState {
+    present: bool,
+    title: Layered<String>,
+    badge: Layered<String>,
+    popup: Layered<String>,
+    enabled: Layered<bool>,
+    icon: Layered<Option<ExtensionActionIcon>>,
+    colors: HashMap<&'static str, Value>,
+}
+
+struct Layered<T> {
+    default: T,
+    tabs: HashMap<i64, T>,
+}
+
+impl<T: Clone> Layered<T> {
+    fn new(default: T) -> Self {
+        Self { default, tabs: HashMap::new() }
+    }
+
+    fn get(&self, tab: Option<i64>) -> T {
+        tab.and_then(|tab| self.tabs.get(&tab)).unwrap_or(&self.default).clone()
+    }
+
+    fn set(&mut self, tab: Option<i64>, value: T) {
+        match tab {
+            Some(tab) => {
+                self.tabs.insert(tab, value);
+            }
+            None => self.default = value,
+        }
+    }
+}
+
+impl ActionState {
+    pub(super) fn from_manifest(manifest: &Manifest, root: &Path) -> Self {
+        let action = manifest.action();
+        let icon = action
+            .as_ref()
+            .and_then(|action| action.default_icon.best(ICON_SIZE as u32).map(str::to_owned))
+            .or_else(|| manifest.icons().best(ICON_SIZE as u32).map(str::to_owned))
+            .and_then(|path| icon_from_file(&root.join(path.trim_start_matches('/'))));
+        Self {
+            present: action.is_some(),
+            title: Layered::new(action.as_ref().and_then(|action| action.default_title.clone()).or_else(|| manifest.name()).unwrap_or_default()),
+            badge: Layered::new(String::new()),
+            popup: Layered::new(action.and_then(|action| action.default_popup).unwrap_or_default()),
+            enabled: Layered::new(true),
+            icon: Layered::new(icon),
+            colors: HashMap::new(),
+        }
+    }
+
+    pub(super) fn popup(&self, tab: Option<i64>) -> Option<String> {
+        Some(self.popup.get(tab)).filter(|popup| !popup.is_empty())
+    }
+}
+
+/// A package image as the 32×32 RGBA tile the toolbar draws, centred.
+fn icon_from_file(path: &Path) -> Option<ExtensionActionIcon> {
+    use gtk::gdk_pixbuf::{Colorspace, InterpType, Pixbuf};
+    let scaled = Pixbuf::from_file_at_scale(path, ICON_SIZE, ICON_SIZE, true).ok()?;
+    let tile = Pixbuf::new(Colorspace::Rgb, true, 8, ICON_SIZE, ICON_SIZE)?;
+    tile.fill(0);
+    let (width, height) = (scaled.width().min(ICON_SIZE), scaled.height().min(ICON_SIZE));
+    let (left, top) = ((ICON_SIZE - width) / 2, (ICON_SIZE - height) / 2);
+    scaled.composite(&tile, left, top, width, height, f64::from(left), f64::from(top), 1.0, 1.0, InterpType::Bilinear, 255);
+    let bytes = tile.read_pixel_bytes();
+    let stride = tile.rowstride() as usize;
+    let mut rgba = Vec::with_capacity((ICON_SIZE * ICON_SIZE * 4) as usize);
+    for row in 0..ICON_SIZE as usize {
+        rgba.extend_from_slice(&bytes[row * stride..row * stride + ICON_SIZE as usize * 4]);
+    }
+    ExtensionActionIcon::from_rgba(rgba).ok()
+}
+
+/// An open popup: a view of the extension's popup page in a popover.
+pub(super) struct Popup {
+    pub(super) view: WebView,
+    popover: gtk::Popover,
+}
+
+impl Popup {
+    pub(super) fn close(self) {
+        self.popover.popdown();
+        self.popover.remove(&self.view);
+        self.view.try_close();
+    }
+}
+
+impl super::super::EngineHost {
+    /// `action.*`, `browserAction.*` and `pageAction.*`, which the API layer
+    /// sends as `action.*`.
+    pub(super) fn linux_action_call(&mut self, profile: ProfileId, extension_id: &str, method: &str, args: &[Value]) -> Result<Value, String> {
+        let details = args.first().cloned().unwrap_or(Value::Null);
+        let tab = details["tabId"].as_i64();
+        let root;
+        let answer = {
+            let install = self
+                .linux_extensions
+                .profiles
+                .get_mut(&profile)
+                .and_then(|state| state.install_mut(extension_id))
+                .ok_or("The extension is not running.")?;
+            root = install.root.clone();
+            let action = &mut install.action;
+            match method {
+                "setTitle" => action.title.set(tab, details["title"].as_str().unwrap_or_default().to_owned()),
+                "setBadgeText" => action.badge.set(tab, details["text"].as_str().unwrap_or_default().to_owned()),
+                "setPopup" => action.popup.set(tab, details["popup"].as_str().unwrap_or_default().trim_start_matches('/').to_owned()),
+                "enable" | "disable" => action.enabled.set(args.first().and_then(Value::as_i64), method == "enable"),
+                "setIcon" => {
+                    let path = match &details["path"] {
+                        Value::String(path) => Some(path.clone()),
+                        Value::Object(sizes) => sizes.iter().max_by_key(|(size, _)| size.parse::<u32>().unwrap_or(0)).and_then(|(_, path)| path.as_str().map(str::to_owned)),
+                        _ => None,
+                    };
+                    let icon = path.and_then(|path| icon_from_file(&root.join(path.trim_start_matches('/'))));
+                    action.icon.set(tab, icon);
+                }
+                "setBadgeBackgroundColor" => {
+                    action.colors.insert("background", details["color"].clone());
+                }
+                "setBadgeTextColor" => {
+                    action.colors.insert("text", details["color"].clone());
+                }
+                "getTitle" => return Ok(json!(action.title.get(tab))),
+                "getBadgeText" => return Ok(json!(action.badge.get(tab))),
+                "getPopup" => return Ok(json!(action.popup(tab).map(|popup| format!("chrome-extension://{extension_id}/{popup}")).unwrap_or_default())),
+                "isEnabled" => return Ok(json!(action.enabled.get(args.first().and_then(Value::as_i64)))),
+                "getBadgeBackgroundColor" => return Ok(action.colors.get("background").cloned().unwrap_or(json!([0, 0, 0, 0]))),
+                "getBadgeTextColor" => return Ok(action.colors.get("text").cloned().unwrap_or(json!([255, 255, 255, 255]))),
+                "getUserSettings" => return Ok(json!({ "isOnToolbar": true })),
+                _ => return Err(format!("action.{method} is not available on Linux yet.")),
+            }
+            Value::Null
+        };
+        self.sink.emit(EngineEvent::ExtensionActionsInvalidated { profile });
+        Ok(answer)
+    }
+
+    pub(crate) fn extension_actions_snapshot(
+        &mut self,
+        profile: ProfileId,
+        tab: ItemId,
+        generation: ExtensionBrowserSurfaceGeneration,
+    ) -> ExtensionActionSnapshotSettlement {
+        let result = (|| {
+            let surface = self.extension_browser_surfaces.get(&profile).ok_or(ExtensionActionRejection::TabUnavailable)?;
+            if surface.generation() != generation
+                || !surface.tabs().any(|candidate| candidate.id() == tab)
+                || self.partitions.get(&tab).is_none_or(|partition| partition.profile() != profile)
+            {
+                return Err(ExtensionActionRejection::TabUnavailable);
+            }
+            let state = self.linux_extensions.profiles.get_mut(&profile).ok_or(ExtensionActionRejection::RuntimeUnavailable)?;
+            let number = state.routing.tabs.number(tab);
+            let mut installs: Vec<_> = state.installs.values().filter(|install| install.action.present).collect();
+            installs.sort_by_key(|install| install.id);
+            let states = installs
+                .into_iter()
+                .filter_map(|install| {
+                    let action = &install.action;
+                    let (label, badge, icon) = (action.title.get(Some(number)), action.badge.get(Some(number)), action.icon.get(Some(number)));
+                    let (enabled, popup) = (action.enabled.get(Some(number)), action.popup(Some(number)).is_some());
+                    let revision = revision(&label, &badge, icon.as_ref(), enabled, popup)?;
+                    ExtensionActionState::new(
+                        ExtensionRuntimeInstance::new(profile, install.id, install.generation),
+                        ExtensionActionScope::Tab(tab),
+                        revision,
+                        &label,
+                        &badge,
+                        icon,
+                        enabled,
+                        popup,
+                        false,
+                    )
+                    .ok()
+                })
+                .collect();
+            ExtensionActionSnapshot::new(profile, tab, generation, states).map_err(|_| ExtensionActionRejection::InvalidRequest)
+        })();
+        match result {
+            Ok(snapshot) => ExtensionActionSnapshotSettlement::Applied(snapshot),
+            Err(error) => ExtensionActionSnapshotSettlement::Rejected(error),
+        }
+    }
+
+    pub(crate) fn invoke_extension_action(&mut self, request: ExtensionActionRequest) -> ExtensionActionSettlement {
+        let runtime = request.runtime();
+        let profile = runtime.profile();
+        if request.is_menu() {
+            // The action's context menu is not drawn on Linux yet.
+            return ExtensionActionSettlement::Dispatched;
+        }
+        let tab_value = self.linux_all_tabs_for_action(profile, request.tab());
+        let Some(state) = self.linux_extensions.profiles.get_mut(&profile) else {
+            return ExtensionActionSettlement::Rejected(ExtensionActionRejection::RuntimeUnavailable);
+        };
+        let number = state.routing.tabs.number(request.tab());
+        let (context, channel) = (state.context.clone(), state.channel.clone());
+        let Some(install) = state.installs.get_mut(&runtime.install_id()) else {
+            return ExtensionActionSettlement::Rejected(ExtensionActionRejection::RuntimeUnavailable);
+        };
+        if install.generation != runtime.generation() {
+            return ExtensionActionSettlement::Rejected(ExtensionActionRejection::RuntimeSuperseded);
+        }
+        if !install.action.enabled.get(Some(number)) {
+            return ExtensionActionSettlement::Rejected(ExtensionActionRejection::ActionDisabled);
+        }
+        install.active_tabs.insert(request.tab());
+        match install.action.popup(Some(number)) {
+            Some(popup) => {
+                let (Some(context), Some(channel), Some(parent)) = (context, channel, crate::platform::imp::container()) else {
+                    return ExtensionActionSettlement::Rejected(ExtensionActionRejection::PopupUnavailable);
+                };
+                if let Some(open) = install.popup.take() {
+                    open.close();
+                }
+                let url = format!("{}{}", install.origin(), popup);
+                let rect = request.anchor().rect();
+                install.popup = Some(open_popup(&context, channel, &parent, &url, rect, profile, install.extension_id.clone()));
+                ExtensionActionSettlement::PopupPresented(Size { width: f64::from(POPUP_SIZE.0), height: f64::from(POPUP_SIZE.1) })
+            }
+            None => {
+                if let Some(background) = &install.background {
+                    raise(&Endpoint { view: background.clone(), frame: 0 }, &install.extension_id, "action.onClicked", json!([tab_value]));
+                }
+                ExtensionActionSettlement::Dispatched
+            }
+        }
+    }
+
+    fn linux_all_tabs_for_action(&mut self, profile: ProfileId, tab: ItemId) -> Value {
+        let number = self.linux_extensions.profiles.get_mut(&profile).map(|state| state.routing.tabs.number(tab));
+        let tabs = self.linux_all_tabs(profile);
+        tabs.into_iter().find(|candidate| number.is_some_and(|number| candidate["id"] == number)).unwrap_or(Value::Null)
+    }
+
+    /// The popover closed itself (a click outside, or the page closed it).
+    fn linux_popup_closed(&mut self, profile: ProfileId, extension_id: &str, view: &WebView) {
+        if let Some(install) = self.linux_extensions.profiles.get_mut(&profile).and_then(|state| state.install_mut(extension_id)) {
+            if install.popup.as_ref().is_some_and(|popup| &popup.view == view) {
+                if let Some(popup) = install.popup.take() {
+                    popup.close();
+                }
+            }
+        }
+    }
+}
+
+fn open_popup(
+    context: &webkit2gtk::WebContext,
+    channel: std::rc::Rc<extension_channel::Channel>,
+    parent: &gtk::Fixed,
+    url: &str,
+    anchor: zephium_core::geometry::Rect,
+    profile: ProfileId,
+    extension_id: String,
+) -> Popup {
+    let view = WebView::with_context(context);
+    view.set_size_request(POPUP_SIZE.0, POPUP_SIZE.1);
+    extension_channel::listen(&view, channel);
+    let popover = gtk::Popover::new(Some(parent));
+    popover.set_pointing_to(&gtk::gdk::Rectangle::new(anchor.x as i32, anchor.y as i32, anchor.width.max(1.0) as i32, anchor.height.max(1.0) as i32));
+    popover.add(&view);
+    view.load_uri(url);
+    let closed_view = view.clone();
+    let closed_extension = extension_id.clone();
+    popover.connect_closed(move |_| {
+        let (view, extension_id) = (closed_view.clone(), closed_extension.clone());
+        super::super::dispatch::best_effort_with(move |host| host.linux_popup_closed(profile, &extension_id, &view));
+    });
+    // `window.close()` in the popup page closes the popover.
+    let page_popover = popover.clone();
+    view.connect_close(move |_| page_popover.popdown());
+    view.show();
+    popover.popup();
+    Popup { view, popover }
+}
+
+/// A revision that changes exactly when what the button shows changes.
+fn revision(label: &str, badge: &str, icon: Option<&ExtensionActionIcon>, enabled: bool, popup: bool) -> Option<ExtensionActionRevision> {
+    let mut hasher = DefaultHasher::new();
+    (label, badge, enabled, popup).hash(&mut hasher);
+    icon.map(|icon| format!("{icon:?}")).hash(&mut hasher);
+    ExtensionActionRevision::new(hasher.finish() | 1)
+}
diff --git a/crates/zephium-engine/src/host/webext_linux/api.rs b/crates/zephium-engine/src/host/webext_linux/api.rs
new file mode 100644
index 00000000..0fa47292
--- /dev/null
+++ b/crates/zephium-engine/src/host/webext_linux/api.rs
@@ -0,0 +1,767 @@
+//! The browser's side of each API call an extension context makes. Requests
+//! arrive as `{"id", "api", "args"}` (the protocol in docs/extensions.md); a
+//! call either answers at once or hands its request to the routing, which
+//! answers when the receivers have.
+
+use std::path::PathBuf;
+use std::sync::Arc;
+use std::time::{Duration, SystemTime, UNIX_EPOCH};
+
+use serde_json::{json, Map, Value};
+use webkit2gtk::{UserMessageExt, WebView, WebViewExt};
+use zephium_core::extensions::{
+    ExtensionBrowserRequest, ExtensionBrowserRequestAction, ExtensionBrowserRequestId, ExtensionBrowserSurface,
+    ExtensionBrowserTab, ExtensionBrowserWindow,
+};
+use zephium_core::ids::{ItemId, ProfileId};
+use zephium_core::ports::engine::EngineEvent;
+use zephium_webext_linux::storage::{Area, Changes, LOCAL_QUOTA};
+use zephium_webext_process::matching::any_matches;
+
+use super::routing::{error, ok, raise, Endpoint};
+use crate::platform::imp::extension_channel::{Message, SenderKind};
+
+/// Chrome's quota for `storage.sync`.
+const SYNC_QUOTA: usize = 100 * 1024;
+/// Chrome's shortest alarm period for installed extensions.
+const SHORTEST_ALARM: Duration = Duration::from_secs(30);
+
+/// An extension's three storage areas.
+pub(super) struct Storage {
+    local: Area,
+    sync: Area,
+    session: Area,
+}
+
+impl Storage {
+    /// On disk under `dir` when the profile has one, in memory otherwise.
+    pub(super) fn open(dir: Option<PathBuf>) -> Result<Self, String> {
+        let area = |name: &str| match &dir {
+            Some(dir) => Area::on_disk(dir.join(format!("{name}.json"))).map_err(|error| error.to_string()),
+            None => Ok(Area::in_memory()),
+        };
+        Ok(Self { local: area("local")?, sync: area("sync")?, session: Area::in_memory() })
+    }
+
+    fn area(&mut self, name: &str) -> Result<&mut Area, String> {
+        match name {
+            "local" => Ok(&mut self.local),
+            "sync" => Ok(&mut self.sync),
+            "session" => Ok(&mut self.session),
+            other => Err(format!("storage.{other} is not available")),
+        }
+    }
+}
+
+/// How a call ends: answered now, or its request went to the routing.
+enum Outcome {
+    Answer(Result<Value, String>),
+    Routed,
+}
+
+impl super::super::EngineHost {
+    /// One request from extension code; see the module comment.
+    pub(super) fn linux_extension_message(&mut self, profile: ProfileId, message: Message) {
+        let Ok(request) = serde_json::from_str::<Value>(&message.body) else {
+            return;
+        };
+        let id = request["id"].as_u64().unwrap_or(0);
+        let api = request["api"].as_str().unwrap_or_default().to_owned();
+        let args = request["args"].as_array().cloned().unwrap_or_default();
+        let known = self
+            .linux_extensions
+            .profiles
+            .get(&profile)
+            .is_some_and(|state| state.install(&message.extension_id).is_some());
+        if !known {
+            return message.reply(&error(id, "The extension is not running."));
+        }
+        let from = Endpoint { view: message.view.clone(), frame: message.frame_id };
+        let reply_with = |message: Message, result: Result<Value, String>| match result {
+            Ok(value) => message.reply(&ok(id, value)),
+            Err(reason) => message.reply(&error(id, &reason)),
+        };
+        // The calls that answer later take the request itself.
+        match api.as_str() {
+            "runtime.sendMessage" => {
+                let payload = message_argument(&args);
+                let sender = self.linux_sender(profile, &message);
+                let targets = self.linux_extension_pages(profile, &message.extension_id, Some(&from));
+                return self.linux_send_message(profile, message, id, payload, sender, targets);
+            }
+            "scripting.executeScript" | "scripting.insertCSS" | "scripting.removeCSS" | "tabs.executeScript" | "tabs.insertCSS" | "tabs.removeCSS" => {
+                return self.linux_inject(profile, message, id, &api, &args);
+            }
+            "tabs.sendMessage" => {
+                let options = args.get(2).cloned().unwrap_or(Value::Null);
+                let target = arg_i64(&args, 0).and_then(|tab| self.linux_tab_view(profile, tab));
+                let Some(view) = target else {
+                    return reply_with(message, Err("No tab with that id.".into()));
+                };
+                let frame = options["frameId"].as_u64().unwrap_or(0);
+                let payload = args.get(1).cloned().unwrap_or(Value::Null);
+                let sender = self.linux_sender(profile, &message);
+                return self.linux_send_message(profile, message, id, payload, sender, vec![Endpoint { view, frame }]);
+            }
+            _ => {}
+        }
+        match self.linux_call(profile, &message, &from, &api, &args) {
+            Outcome::Answer(result) => reply_with(message, result),
+            Outcome::Routed => {}
+        }
+    }
+
+    /// `scripting.*` and MV2's `tabs.executeScript` / `insertCSS`: code or CSS
+    /// run in the extension's world of a tab it may touch.
+    fn linux_inject(&mut self, profile: ProfileId, message: Message, id: u64, api: &str, args: &[Value]) {
+        let mv2 = api.starts_with("tabs.");
+        let (tab, details) = if mv2 {
+            match args.first() {
+                Some(Value::Number(_)) => (arg_i64(args, 0), args.get(1).cloned().unwrap_or(Value::Null)),
+                _ => (None, args.first().cloned().unwrap_or(Value::Null)),
+            }
+        } else {
+            let injection = args.first().cloned().unwrap_or(Value::Null);
+            (injection["target"]["tabId"].as_i64(), injection)
+        };
+        let prepared = self.linux_injection(profile, &message.extension_id, tab, api, &details);
+        let (view, code) = match prepared {
+            Ok(prepared) => prepared,
+            Err(reason) => return message.reply(&error(id, &reason)),
+        };
+        let run = webkit2gtk::UserMessage::new(
+            zephium_webext_process::RUN_MESSAGE,
+            Some(&gtk::glib::ToVariant::to_variant(&(message.extension_id.as_str(), code.as_str()))),
+        );
+        view.send_message_to_page(&run, None::<&gtk::gio::Cancellable>, move |reply| {
+            let answer = reply
+                .ok()
+                .and_then(|reply| reply.parameters())
+                .and_then(|parameters| parameters.get::<(String,)>())
+                .and_then(|(text,)| serde_json::from_str::<Value>(&text).ok())
+                .unwrap_or_else(|| json!({ "error": "The page could not be reached." }));
+            match answer.get("error").and_then(Value::as_str) {
+                Some(reason) => message.reply(&error(id, reason)),
+                None if mv2 => message.reply(&ok(id, json!([answer["ok"]]))),
+                None => message.reply(&ok(id, json!([{ "frameId": 0, "result": answer["ok"] }]))),
+            }
+        });
+    }
+
+    /// The tab's view and the code to run there, once the extension is
+    /// allowed to: host permission for the tab's address, or `activeTab`.
+    fn linux_injection(&mut self, profile: ProfileId, extension_id: &str, tab: Option<i64>, api: &str, details: &Value) -> Result<(WebView, String), String> {
+        let item = match tab {
+            Some(number) => self.linux_tab_item(profile, number),
+            None => self.linux_focused_tab(profile),
+        }
+        .ok_or("No tab with that id.")?;
+        let view = {
+            use wry::WebViewExtUnix;
+            self.views.get(&item).map(|observed| observed.view.webview()).ok_or("The tab is not loaded.")?
+        };
+        let url = view.uri().map(|uri| uri.to_string()).unwrap_or_default();
+        let install = self.linux_extensions.profiles.get(&profile).and_then(|state| state.install(extension_id)).ok_or("The extension is not running.")?;
+        let allowed = install.active_tabs.contains(&item) || any_matches(&install.hosts, &url);
+        if !allowed {
+            return Err("Cannot access contents of the page. Extension manifest must request permission to access the respective host.".into());
+        }
+        let files: Vec<String> = match &details["files"] {
+            Value::Array(files) => files.iter().filter_map(|file| file.as_str().map(str::to_owned)).collect(),
+            _ => details["file"].as_str().map(str::to_owned).into_iter().collect(),
+        };
+        let mut source = files.iter().map(|file| read_package_text(&install.root, file)).collect::<Result<Vec<_>, _>>()?.join("\n;");
+        let inline = details["code"].as_str().or(details["css"].as_str()).unwrap_or_default();
+        if !inline.is_empty() {
+            source.push_str(inline);
+        }
+        let code = if api.ends_with("insertCSS") {
+            insert_css(&source)
+        } else if api.ends_with("removeCSS") {
+            remove_css(&source)
+        } else {
+            source
+        };
+        // The API layer goes first, so injected code can use chrome.*.
+        Ok((view, format!("{}\n;{code}", zephium_webext_linux::SCRIPT)))
+    }
+
+    fn linux_call(&mut self, profile: ProfileId, message: &Message, from: &Endpoint, api: &str, args: &[Value]) -> Outcome {
+        let extension_id = message.extension_id.as_str();
+        let (namespace, method) = api.split_once('.').unwrap_or((api, ""));
+        let result = match namespace {
+            "runtime" => self.linux_runtime(profile, message, from, method, args),
+            "port" => match method {
+                "post" => self.linux_port_post(profile, from, arg_u64(args, 0), args.get(1).cloned().unwrap_or(Value::Null)),
+                "disconnect" => self.linux_port_disconnect(profile, from, arg_u64(args, 0)),
+                _ => unsupported(api),
+            },
+            "storage" => self.linux_storage(profile, extension_id, method, args),
+            "tabs" => self.linux_tabs(profile, message, from, method, args),
+            "windows" => self.linux_windows(profile, message, method, args),
+            "action" => self.linux_action_call(profile, extension_id, method, args),
+            "alarms" => self.linux_alarms(profile, extension_id, method, args),
+            "permissions" => self.linux_permissions(profile, extension_id, method, args),
+            "i18n" if method == "getAcceptLanguages" => Ok(json!(["en-US", "en"])),
+            "extension" if method == "isAllowedIncognitoAccess" => Ok(json!(false)),
+            "commands" if method == "getAll" => Ok(self.linux_commands(profile, extension_id)),
+            "notifications" => linux_notification(extension_id, method, args),
+            "contextMenus" => Ok(Value::Null),
+            "cookies" => Ok(if method == "getAll" { json!([]) } else { Value::Null }),
+            "webNavigation" => Ok(Value::Null),
+            _ => unsupported(api),
+        };
+        Outcome::Answer(result)
+    }
+
+    fn linux_runtime(&mut self, profile: ProfileId, message: &Message, from: &Endpoint, method: &str, args: &[Value]) -> Result<Value, String> {
+        match method {
+            "answer" => {
+                self.linux_message_answered(profile, arg_u64(args, 0), args.get(1).cloned().unwrap_or(Value::Null), args.get(2).and_then(Value::as_bool).unwrap_or(false));
+                Ok(Value::Null)
+            }
+            "connect" => {
+                let info = args.iter().find(|arg| arg.is_object()).cloned().unwrap_or(Value::Null);
+                let name = info["name"].as_str().unwrap_or_default().to_owned();
+                let sender = self.linux_sender(profile, message);
+                let receivers = self.linux_extension_pages(profile, &message.extension_id, Some(from));
+                self.linux_connect(profile, &message.extension_id, from.clone(), &name, sender, receivers)
+            }
+            "getPlatformInfo" => Ok(json!({ "os": "linux", "arch": "x86-64", "nacl_arch": "x86-64" })),
+            "openOptionsPage" => {
+                self.open_web_extension_options(profile, &message.extension_id);
+                Ok(Value::Null)
+            }
+            "setUninstallURL" => Ok(Value::Null),
+            "reload" => {
+                if let Some(install) = self.linux_extensions.profiles.get_mut(&profile).and_then(|state| state.install_mut(&message.extension_id)) {
+                    if let Some(background) = install.background.take() {
+                        background.try_close();
+                    }
+                }
+                self.linux_extensions_sync(profile);
+                Ok(Value::Null)
+            }
+            _ => unsupported(&format!("runtime.{method}")),
+        }
+    }
+
+    fn linux_storage(&mut self, profile: ProfileId, extension_id: &str, method: &str, args: &[Value]) -> Result<Value, String> {
+        let area_name = args.first().and_then(Value::as_str).unwrap_or("local").to_owned();
+        let argument = args.get(1).cloned().unwrap_or(Value::Null);
+        let install = self.linux_extensions.profiles.get_mut(&profile).and_then(|state| state.install_mut(extension_id)).ok_or("The extension is not running.")?;
+        let unlimited = install.permissions.iter().any(|permission| permission == "unlimitedStorage");
+        let quota = match area_name.as_str() {
+            "local" if !unlimited => Some(LOCAL_QUOTA),
+            "sync" => Some(SYNC_QUOTA),
+            _ => None,
+        };
+        let area = install.storage.area(&area_name)?;
+        let changes = match method {
+            "get" => return Ok(Value::Object(area.get(&argument))),
+            "getBytesInUse" => return Ok(json!(area.bytes_in_use(&argument))),
+            "set" => area.set(argument.as_object().cloned().unwrap_or_default(), quota)?,
+            "remove" => area.remove(&argument)?,
+            "clear" => area.clear()?,
+            _ => return unsupported(&format!("storage.{method}")),
+        };
+        if !changes.is_empty() {
+            self.linux_storage_changed(profile, extension_id, &area_name, changes);
+        }
+        Ok(Value::Null)
+    }
+
+    /// `storage.onChanged` in every context of the extension.
+    fn linux_storage_changed(&mut self, profile: ProfileId, extension_id: &str, area: &str, changes: Changes) {
+        let changes = Value::Object(changes);
+        for endpoint in self.linux_every_context(profile, extension_id) {
+            raise(&endpoint, extension_id, "storage.onChanged", json!([changes.clone(), area]));
+            raise(&endpoint, extension_id, &format!("storage.{area}.onChanged"), json!([changes.clone()]));
+        }
+    }
+
+    fn linux_tabs(&mut self, profile: ProfileId, message: &Message, from: &Endpoint, method: &str, args: &[Value]) -> Result<Value, String> {
+        match method {
+            "query" => Ok(Value::Array(self.linux_query_tabs(profile, message, args.first().unwrap_or(&Value::Null)))),
+            "get" => {
+                let wanted = arg_i64(args, 0).ok_or("No tab with that id.")?;
+                self.linux_all_tabs(profile).into_iter().find(|tab| tab["id"] == wanted).ok_or_else(|| "No tab with that id.".into())
+            }
+            "getCurrent" => Ok(self.linux_sender_tab(profile, message).unwrap_or(Value::Null)),
+            "create" => {
+                let properties = args.first().cloned().unwrap_or(Value::Null);
+                let url = properties["url"].as_str().map(|url| self.linux_absolute(profile, &message.extension_id, url));
+                self.linux_request_tab(profile, url, properties["active"].as_bool().unwrap_or(true));
+                Ok(Value::Null)
+            }
+            "update" => {
+                let (tab, properties) = match args.first() {
+                    Some(Value::Number(_)) => (arg_i64(args, 0).and_then(|tab| self.linux_tab_item(profile, tab)), args.get(1).cloned().unwrap_or(Value::Null)),
+                    _ => (self.linux_focused_tab(profile), args.first().cloned().unwrap_or(Value::Null)),
+                };
+                let tab = tab.ok_or("No tab with that id.")?;
+                if let Some(url) = properties["url"].as_str() {
+                    let url = self.linux_absolute(profile, &message.extension_id, url);
+                    self.linux_browser_request(profile, ExtensionBrowserRequestAction::LoadTabUrl { tab, url: Arc::from(url.as_str()) });
+                }
+                if properties["active"].as_bool() == Some(true) {
+                    self.linux_browser_request(profile, ExtensionBrowserRequestAction::ActivateTab { tab });
+                }
+                Ok(Value::Null)
+            }
+            "remove" => {
+                let numbers: Vec<i64> = match args.first() {
+                    Some(Value::Array(list)) => list.iter().filter_map(Value::as_i64).collect(),
+                    Some(value) => value.as_i64().into_iter().collect(),
+                    None => Vec::new(),
+                };
+                let tabs: Vec<ItemId> = numbers.into_iter().filter_map(|number| self.linux_tab_item(profile, number)).collect();
+                for tab in tabs {
+                    self.linux_browser_request(profile, ExtensionBrowserRequestAction::CloseTab { tab });
+                }
+                Ok(Value::Null)
+            }
+            "reload" => {
+                let tab = arg_i64(args, 0).and_then(|number| self.linux_tab_item(profile, number)).or_else(|| self.linux_focused_tab(profile));
+                if let Some(tab) = tab {
+                    self.linux_browser_request(profile, ExtensionBrowserRequestAction::ReloadTab { tab });
+                }
+                Ok(Value::Null)
+            }
+            "connect" => {
+                let view = arg_i64(args, 0).and_then(|tab| self.linux_tab_view(profile, tab)).ok_or("No tab with that id.")?;
+                let info = args.get(1).cloned().unwrap_or(Value::Null);
+                let frame = info["frameId"].as_u64().unwrap_or(0);
+                let name = info["name"].as_str().unwrap_or_default().to_owned();
+                let sender = self.linux_sender(profile, message);
+                self.linux_connect(profile, &message.extension_id, from.clone(), &name, sender, vec![Endpoint { view, frame }])
+            }
+            _ => unsupported(&format!("tabs.{method}")),
+        }
+    }
+
+    fn linux_windows(&mut self, profile: ProfileId, message: &Message, method: &str, args: &[Value]) -> Result<Value, String> {
+        let populate = args.iter().any(|arg| arg["populate"].as_bool() == Some(true));
+        let windows = self.linux_all_windows(profile, populate);
+        match method {
+            "getAll" => Ok(Value::Array(windows)),
+            "get" => {
+                let wanted = arg_i64(args, 0).ok_or("No window with that id.")?;
+                windows.into_iter().find(|window| window["id"] == wanted).ok_or_else(|| "No window with that id.".into())
+            }
+            "getCurrent" | "getLastFocused" => {
+                let current = self.linux_sender_tab(profile, message).map(|tab| tab["windowId"].clone());
+                Ok(windows
+                    .iter()
+                    .find(|window| current.as_ref().is_some_and(|id| &window["id"] == id))
+                    .or_else(|| windows.iter().find(|window| window["focused"] == true))
+                    .or(windows.first())
+                    .cloned()
+                    .unwrap_or(Value::Null))
+            }
+            _ => unsupported(&format!("windows.{method}")),
+        }
+    }
+
+    fn linux_alarms(&mut self, profile: ProfileId, extension_id: &str, method: &str, args: &[Value]) -> Result<Value, String> {
+        let install = self.linux_extensions.profiles.get_mut(&profile).and_then(|state| state.install_mut(extension_id)).ok_or("The extension is not running.")?;
+        match method {
+            "create" => {
+                let (name, info) = match args.first() {
+                    Some(Value::String(name)) => (name.clone(), args.get(1).cloned().unwrap_or(Value::Null)),
+                    other => (String::new(), other.cloned().unwrap_or(Value::Null)),
+                };
+                let minutes = |key: &str| info[key].as_f64().map(|value| Duration::from_secs_f64(value * 60.0));
+                let period = minutes("periodInMinutes").map(|period| period.max(SHORTEST_ALARM));
+                let delay = info["when"]
+                    .as_f64()
+                    .map(|when| Duration::from_millis((when - now_ms()).max(0.0) as u64))
+                    .or_else(|| minutes("delayInMinutes"))
+                    .or(period)
+                    .unwrap_or(SHORTEST_ALARM)
+                    .max(Duration::from_secs(1));
+                if let Some(previous) = install.alarms.remove(&name) {
+                    previous.remove();
+                }
+                let alarm = json!({ "name": name, "scheduledTime": now_ms() + delay.as_millis() as f64, "periodInMinutes": info["periodInMinutes"] });
+                let (extension, alarm_name) = (extension_id.to_owned(), name.clone());
+                let source = schedule_alarm(profile, extension, alarm_name, alarm, delay, period);
+                install.alarms.insert(name, source);
+                Ok(Value::Null)
+            }
+            "get" => Ok(install.alarms.contains_key(args.first().and_then(Value::as_str).unwrap_or_default()).then(|| json!({ "name": args.first() })).unwrap_or(Value::Null)),
+            "getAll" => Ok(Value::Array(install.alarms.keys().map(|name| json!({ "name": name })).collect())),
+            "clear" => {
+                let name = args.first().and_then(Value::as_str).unwrap_or_default();
+                Ok(json!(install.alarms.remove(name).map(|source| source.remove()).is_some()))
+            }
+            "clearAll" => {
+                for (_, source) in install.alarms.drain() {
+                    source.remove();
+                }
+                Ok(json!(true))
+            }
+            _ => unsupported(&format!("alarms.{method}")),
+        }
+    }
+
+    /// An alarm went off: raise `alarms.onAlarm` in the background.
+    fn linux_alarm(&mut self, profile: ProfileId, extension_id: &str, name: &str, alarm: Value, repeating: bool) {
+        let Some(install) = self.linux_extensions.profiles.get_mut(&profile).and_then(|state| state.install_mut(extension_id)) else {
+            return;
+        };
+        if !repeating {
+            // The one-shot source has already ended; only forget its ID.
+            install.alarms.remove(name);
+        }
+        if let Some(background) = &install.background {
+            raise(&Endpoint { view: background.clone(), frame: 0 }, extension_id, "alarms.onAlarm", json!([alarm]));
+        }
+    }
+
+    fn linux_permissions(&mut self, profile: ProfileId, extension_id: &str, method: &str, args: &[Value]) -> Result<Value, String> {
+        let state = self.linux_extensions.profiles.get(&profile).ok_or("The extension is not running.")?;
+        let install = state.install(extension_id).ok_or("The extension is not running.")?;
+        match method {
+            "getAll" => Ok(json!({ "permissions": install.permissions, "origins": install.hosts })),
+            "contains" => {
+                let wanted = args.first().cloned().unwrap_or(Value::Null);
+                let permissions = strings(&wanted["permissions"]).iter().all(|permission| install.permissions.contains(permission));
+                let origins = strings(&wanted["origins"]).iter().all(|origin| {
+                    install.hosts.iter().any(|host| host == origin || host == "<all_urls>" || any_matches(std::slice::from_ref(host), origin.trim_end_matches('*')))
+                });
+                Ok(json!(permissions && origins))
+            }
+            // Runtime grants are not offered on Linux yet: asking is refused,
+            // and nothing granted can be given back.
+            "request" | "remove" => Ok(json!(false)),
+            _ => unsupported(&format!("permissions.{method}")),
+        }
+    }
+
+    fn linux_commands(&self, profile: ProfileId, extension_id: &str) -> Value {
+        let Some(install) = self.linux_extensions.profiles.get(&profile).and_then(|state| state.install(extension_id)) else {
+            return json!([]);
+        };
+        let Some(commands) = install.manifest.raw()["commands"].as_object() else {
+            return json!([]);
+        };
+        Value::Array(
+            commands
+                .iter()
+                .map(|(name, command)| json!({ "name": name, "description": command["description"], "shortcut": command["suggested_key"]["linux"].as_str().or(command["suggested_key"]["default"].as_str()).unwrap_or("") }))
+                .collect(),
+        )
+    }
+
+    // ---- Who is asking, and where things are --------------------------------
+
+    /// Chrome's `MessageSender` for `message`.
+    pub(super) fn linux_sender(&mut self, profile: ProfileId, message: &Message) -> Value {
+        let mut sender = Map::new();
+        sender.insert("id".into(), json!(message.extension_id));
+        sender.insert("url".into(), json!(message.view.uri().map(|uri| uri.to_string())));
+        sender.insert("frameId".into(), json!(message.frame_id));
+        if message.kind == SenderKind::Content {
+            if let Some(tab) = self.linux_sender_tab(profile, message) {
+                sender.insert("tab".into(), tab);
+            }
+        }
+        Value::Object(sender)
+    }
+
+    fn linux_sender_tab(&mut self, profile: ProfileId, message: &Message) -> Option<Value> {
+        let item = self.linux_tab_of_view(profile, &message.view)?;
+        let number = self.linux_extensions.profiles.get_mut(&profile)?.routing.tabs.number(item);
+        self.linux_all_tabs(profile).into_iter().find(|tab| tab["id"] == number)
+    }
+
+    fn linux_tab_of_view(&self, profile: ProfileId, view: &WebView) -> Option<ItemId> {
+        use wry::WebViewExtUnix;
+        self.views
+            .iter()
+            .find(|(id, observed)| {
+                self.partitions.get(id).is_some_and(|partition| partition.profile() == profile) && &observed.view.webview() == view
+            })
+            .map(|(id, _)| *id)
+    }
+
+    fn linux_tab_item(&self, profile: ProfileId, number: i64) -> Option<ItemId> {
+        self.linux_extensions.profiles.get(&profile)?.routing.tabs.item(number)
+    }
+
+    fn linux_tab_view(&self, profile: ProfileId, number: i64) -> Option<WebView> {
+        use wry::WebViewExtUnix;
+        let item = self.linux_tab_item(profile, number)?;
+        self.views.get(&item).map(|observed| observed.view.webview())
+    }
+
+    fn linux_focused_tab(&self, profile: ProfileId) -> Option<ItemId> {
+        let surface = self.extension_browser_surfaces.get(&profile)?;
+        let window = surface.windows().iter().find(|window| Some(window.id()) == surface.focused()).or(surface.windows().first())?;
+        window.active()
+    }
+
+    /// Every view of the profile's tabs, for events every context gets.
+    pub(super) fn linux_tab_views(&self, profile: ProfileId) -> Vec<WebView> {
+        use wry::WebViewExtUnix;
+        self.views
+            .iter()
+            .filter(|(id, _)| self.partitions.get(id).is_some_and(|partition| partition.profile() == profile))
+            .map(|(_, observed)| observed.view.webview())
+            .collect()
+    }
+
+    /// The extension's own pages, other than `except`: its background, its
+    /// popup and any of its pages open in tabs.
+    pub(super) fn linux_extension_pages(&self, profile: ProfileId, extension_id: &str, except: Option<&Endpoint>) -> Vec<Endpoint> {
+        let Some(install) = self.linux_extensions.profiles.get(&profile).and_then(|state| state.install(extension_id)) else {
+            return Vec::new();
+        };
+        let origin = install.origin();
+        let tabs = self.linux_tab_views(profile).into_iter().filter(|view| view.uri().is_some_and(|uri| uri.starts_with(&origin)));
+        install
+            .own_views()
+            .into_iter()
+            .chain(tabs)
+            .filter(|view| except.is_none_or(|except| &except.view != view))
+            .map(|view| Endpoint { view, frame: 0 })
+            .collect()
+    }
+
+    fn linux_every_context(&self, profile: ProfileId, extension_id: &str) -> Vec<Endpoint> {
+        let mut endpoints = self.linux_extension_pages(profile, extension_id, None);
+        for view in self.linux_tab_views(profile) {
+            if !endpoints.iter().any(|endpoint| endpoint.view == view) {
+                endpoints.push(Endpoint { view, frame: 0 });
+            }
+        }
+        endpoints
+    }
+
+    fn linux_all_windows(&mut self, profile: ProfileId, populate: bool) -> Vec<Value> {
+        let Some(surface) = self.extension_browser_surfaces.get(&profile).cloned() else {
+            return Vec::new();
+        };
+        let Some(state) = self.linux_extensions.profiles.get_mut(&profile) else {
+            return Vec::new();
+        };
+        public_windows(&surface)
+            .map(|window| {
+                let id = state.routing.windows.number(window.id());
+                let mut value = json!({
+                    "id": id, "focused": surface.focused() == Some(window.id()), "incognito": false,
+                    "type": "normal", "state": "normal", "alwaysOnTop": false,
+                });
+                if populate {
+                    value["tabs"] = Value::Array(window.tabs().iter().enumerate().map(|(index, tab)| tab_value(state, window, index, tab)).collect());
+                }
+                value
+            })
+            .collect()
+    }
+
+    pub(super) fn linux_all_tabs(&mut self, profile: ProfileId) -> Vec<Value> {
+        let Some(surface) = self.extension_browser_surfaces.get(&profile).cloned() else {
+            return Vec::new();
+        };
+        let Some(state) = self.linux_extensions.profiles.get_mut(&profile) else {
+            return Vec::new();
+        };
+        public_windows(&surface)
+            .flat_map(|window| window.tabs().iter().enumerate().map(move |(index, tab)| (window, index, tab)))
+            .map(|(window, index, tab)| tab_value(state, window, index, tab))
+            .collect()
+    }
+
+    fn linux_query_tabs(&mut self, profile: ProfileId, message: &Message, query: &Value) -> Vec<Value> {
+        let current_window = self.linux_sender_tab(profile, message).map(|tab| tab["windowId"].clone()).or_else(|| {
+            let windows = self.linux_all_windows(profile, false);
+            windows.iter().find(|window| window["focused"] == true).map(|window| window["id"].clone())
+        });
+        let wants_current = query["currentWindow"].as_bool() == Some(true)
+            || query["lastFocusedWindow"].as_bool() == Some(true)
+            || query["windowId"].as_i64() == Some(-2);
+        let urls = strings(&query["url"]);
+        self.linux_all_tabs(profile)
+            .into_iter()
+            .filter(|tab| !wants_current || current_window.as_ref() == Some(&tab["windowId"]))
+            .filter(|tab| query["windowId"].as_i64().is_none_or(|id| id < 0 || tab["windowId"] == id))
+            .filter(|tab| ["active", "pinned", "audible", "highlighted"].iter().all(|key| query[*key].as_bool().is_none_or(|wanted| tab[*key] == wanted)))
+            .filter(|tab| query["status"].as_str().is_none_or(|status| tab["status"] == status))
+            .filter(|tab| urls.is_empty() || tab["url"].as_str().is_some_and(|url| any_matches(&urls, url)))
+            .collect()
+    }
+
+    /// An extension-relative URL made absolute in its origin.
+    fn linux_absolute(&self, profile: ProfileId, extension_id: &str, url: &str) -> String {
+        if url.contains("://") || url.starts_with("about:") || url.starts_with("data:") {
+            return url.to_owned();
+        }
+        let origin = self.linux_extensions.profiles.get(&profile).and_then(|state| state.install(extension_id)).map(super::Install::origin).unwrap_or_default();
+        format!("{origin}{}", url.trim_start_matches('/'))
+    }
+
+    /// Ask the shell to open a tab.
+    pub(super) fn linux_request_tab(&mut self, profile: ProfileId, url: Option<String>, active: bool) {
+        let url = url.map(|url| Arc::from(url.as_str()));
+        self.linux_browser_request(profile, ExtensionBrowserRequestAction::CreateTab { window: None, url, active });
+    }
+
+    /// One tab or window request to the shell, as macOS raises them.
+    fn linux_browser_request(&mut self, profile: ProfileId, action: ExtensionBrowserRequestAction) {
+        self.linux_extensions.next_request += 1;
+        let Some(id) = ExtensionBrowserRequestId::new(LINUX_REQUESTS | self.linux_extensions.next_request) else {
+            return;
+        };
+        if let Ok(request) = ExtensionBrowserRequest::new(profile, id, action) {
+            self.sink.emit(EngineEvent::ExtensionBrowserRequested { request });
+        }
+    }
+}
+
+/// Request numbers the Linux runtime raises, apart from anything else's.
+const LINUX_REQUESTS: u64 = 1 << 62;
+
+/// The first run waits for `delay`; a repeating alarm then runs every
+/// `period`, its new source replacing the first in the install's alarms.
+fn schedule_alarm(profile: ProfileId, extension: String, name: String, alarm: Value, delay: Duration, period: Option<Duration>) -> gtk::glib::SourceId {
+    gtk::glib::timeout_add_local_once(delay, move || {
+        super::super::dispatch::best_effort_with(move |host| {
+            host.linux_alarm(profile, &extension, &name, alarm.clone(), period.is_some());
+            let Some(period) = period else {
+                return;
+            };
+            let repeat = gtk::glib::timeout_add_local(period, {
+                let (extension, name) = (extension.clone(), name.clone());
+                move || {
+                    let (extension, name, alarm) = (extension.clone(), name.clone(), alarm.clone());
+                    super::super::dispatch::best_effort_with(move |host| host.linux_alarm(profile, &extension, &name, alarm, true));
+                    gtk::glib::ControlFlow::Continue
+                }
+            });
+            if let Some(install) = host.linux_extensions.profiles.get_mut(&profile).and_then(|state| state.install_mut(&extension)) {
+                install.alarms.insert(name, repeat);
+            }
+        });
+    })
+}
+
+fn linux_notification(extension_id: &str, method: &str, args: &[Value]) -> Result<Value, String> {
+    use gtk::gio::prelude::*;
+    match method {
+        "create" => {
+            let (id, options) = match args.first() {
+                Some(Value::String(id)) => (id.clone(), args.get(1).cloned().unwrap_or(Value::Null)),
+                other => (format!("{:x}", now_ms() as u64), other.cloned().unwrap_or(Value::Null)),
+            };
+            if let Some(application) = gtk::gio::Application::default() {
+                let notification = gtk::gio::Notification::new(options["title"].as_str().unwrap_or_default());
+                notification.set_body(options["message"].as_str());
+                application.send_notification(Some(&format!("{extension_id}-{id}")), &notification);
+            }
+            Ok(json!(id))
+        }
+        "clear" => {
+            if let (Some(application), Some(id)) = (gtk::gio::Application::default(), args.first().and_then(Value::as_str)) {
+                application.withdraw_notification(&format!("{extension_id}-{id}"));
+            }
+            Ok(json!(true))
+        }
+        "update" => Ok(json!(false)),
+        "getAll" => Ok(json!({})),
+        _ => unsupported(&format!("notifications.{method}")),
+    }
+}
+
+fn public_windows(surface: &ExtensionBrowserSurface) -> impl Iterator<Item = &ExtensionBrowserWindow> {
+    surface.windows().iter().filter(|window| !window.is_private())
+}
+
+fn tab_value(state: &mut super::ProfileExtensions, window: &ExtensionBrowserWindow, index: usize, tab: &ExtensionBrowserTab) -> Value {
+    let active = window.active() == Some(tab.id());
+    json!({
+        "id": state.routing.tabs.number(tab.id()),
+        "index": index,
+        "windowId": state.routing.windows.number(window.id()),
+        "active": active,
+        "highlighted": active,
+        "selected": active,
+        "pinned": tab.pinned(),
+        "audible": tab.audible(),
+        "discarded": tab.discarded(),
+        "autoDiscardable": true,
+        "mutedInfo": { "muted": tab.muted() },
+        "incognito": false,
+        "url": tab.url(),
+        "title": tab.title().to_string(),
+        "status": if tab.loading() { "loading" } else { "complete" },
+        "groupId": -1,
+    })
+}
+
+/// `runtime.sendMessage([extensionId], message, [options])`: the message. An
+/// extension ID comes first only when another argument follows it.
+fn message_argument(args: &[Value]) -> Value {
+    match args {
+        [Value::String(id), message, ..] if is_extension_id(id) => message.clone(),
+        [message, ..] => message.clone(),
+        [] => Value::Null,
+    }
+}
+
+fn is_extension_id(text: &str) -> bool {
+    text.len() == 32 && text.bytes().all(|byte| (b'a'..=b'p').contains(&byte))
+}
+
+/// A text file of the package, refusing paths that would leave it.
+fn read_package_text(root: &std::path::Path, path: &str) -> Result<String, String> {
+    let relative = std::path::Path::new(path.trim_start_matches('/'));
+    if relative.components().any(|part| !matches!(part, std::path::Component::Normal(_))) {
+        return Err(format!("{path} is outside the extension."));
+    }
+    std::fs::read_to_string(root.join(relative)).map_err(|reason| format!("{path}: {reason}"))
+}
+
+/// CSS goes into the page as a `<style>` marked with its own hash, so
+/// `removeCSS` with the same text finds it again.
+fn insert_css(css: &str) -> String {
+    format!(
+        r#"(() => {{ const style = document.createElement("style"); style.dataset.zephiumCss = "{}"; style.textContent = {}; (document.head || document.documentElement).append(style); }})()"#,
+        css_mark(css),
+        Value::String(css.to_owned())
+    )
+}
+
+fn remove_css(css: &str) -> String {
+    format!(r#"document.querySelectorAll('style[data-zephium-css="{}"]').forEach((style) => style.remove())"#, css_mark(css))
+}
+
+fn css_mark(css: &str) -> String {
+    let hash = css.bytes().fold(0xcbf2_9ce4_8422_2325_u64, |hash, byte| (hash ^ u64::from(byte)).wrapping_mul(0x0100_0000_01b3));
+    format!("{hash:016x}")
+}
+
+fn strings(value: &Value) -> Vec<String> {
+    match value {
+        Value::String(text) => vec![text.clone()],
+        Value::Array(list) => list.iter().filter_map(|item| item.as_str().map(str::to_owned)).collect(),
+        _ => Vec::new(),
+    }
+}
+
+fn arg_u64(args: &[Value], index: usize) -> u64 {
+    args.get(index).and_then(Value::as_u64).unwrap_or(0)
+}
+
+fn arg_i64(args: &[Value], index: usize) -> Option<i64> {
+    args.get(index).and_then(Value::as_i64)
+}
+
+fn now_ms() -> f64 {
+    SystemTime::now().duration_since(UNIX_EPOCH).map_or(0.0, |elapsed| elapsed.as_millis() as f64)
+}
+
+fn unsupported(api: &str) -> Result<Value, String> {
+    Err(format!("{api} is not available on Linux yet."))
+}
diff --git a/crates/zephium-engine/src/host/webext_linux/mod.rs b/crates/zephium-engine/src/host/webext_linux/mod.rs
new file mode 100644
index 00000000..df5733b0
--- /dev/null
+++ b/crates/zephium-engine/src/host/webext_linux/mod.rs
@@ -0,0 +1,377 @@
+//! Browser extensions on Linux: the engine's side of the port's runtime.
+//!
+//! WebKitGTK has no extension engine, so a profile's extensions run on the
+//! port's own pieces: the web-process plugin (`zephium-webext-process`) runs
+//! content scripts and carries messages, `zephium-webext-linux` holds the API
+//! layer and storage, and this module loads packages, serves their pages, keeps
+//! one hidden background view per extension, answers API calls and draws the
+//! toolbar actions. Design: the Linux port's docs/extensions.md.
+
+mod action;
+mod api;
+mod routing;
+mod scheme;
+
+/// Log one step of the runtime when `ZEPHIUM_WEBEXT_TRACE` is set; silent
+/// otherwise. For finding where an extension stops working.
+macro_rules! trace {
+    ($($argument:tt)*) => {
+        if std::env::var_os("ZEPHIUM_WEBEXT_TRACE").is_some() {
+            eprintln!("webext: {}", format!($($argument)*));
+        }
+    };
+}
+pub(super) use trace;
+
+use std::collections::{HashMap, HashSet};
+use std::path::PathBuf;
+use std::rc::Rc;
+
+use webkit2gtk::{SettingsExt, WebContext, WebView, WebViewExt};
+use wry::WebViewExtUnix;
+use zephium_core::extensions::ExtensionRuntimeGeneration;
+use zephium_core::ids::{ExtensionInstallId, ProfileId};
+use zephium_core::ports::engine::{EngineEvent, WebExtensionLoad, WebExtensionLoaded};
+use zephium_webext::manifest::{Background, Manifest};
+
+use crate::platform::imp::extension_channel::{self, Channel, ChannelExtension};
+
+/// Every profile's extensions.
+#[derive(Default)]
+pub(super) struct LinuxExtensions {
+    profiles: HashMap<ProfileId, ProfileExtensions>,
+    /// Extension IDs whose pages a profile's tabs may open, shared with each
+    /// view's event permit as on Windows.
+    navigation: HashMap<ProfileId, super::permits::ExtensionNavigationGrants>,
+    /// Numbers the tab and window requests this runtime raises.
+    next_request: u64,
+}
+
+impl LinuxExtensions {
+    pub(super) fn navigation_grants(&mut self, profile: ProfileId) -> super::permits::ExtensionNavigationGrants {
+        self.navigation.entry(profile).or_default().clone()
+    }
+
+    fn set_navigation(&mut self, profile: ProfileId, ids: HashSet<String>) {
+        let grants = self.navigation_grants(profile);
+        *grants.lock().unwrap_or_else(|error| error.into_inner()) = ids;
+    }
+}
+
+/// One profile's extensions and what they run in.
+#[derive(Default)]
+pub(super) struct ProfileExtensions {
+    /// The profile's WebKit context, once one of its views exists.
+    context: Option<WebContext>,
+    channel: Option<Rc<Channel>>,
+    packages: scheme::Packages,
+    installs: HashMap<ExtensionInstallId, Install>,
+    routing: routing::Routing,
+}
+
+impl ProfileExtensions {
+    fn install(&self, extension_id: &str) -> Option<&Install> {
+        self.installs.values().find(|install| install.extension_id == extension_id)
+    }
+
+    fn install_mut(&mut self, extension_id: &str) -> Option<&mut Install> {
+        self.installs.values_mut().find(|install| install.extension_id == extension_id)
+    }
+}
+
+/// One loaded extension.
+pub(super) struct Install {
+    pub(super) id: ExtensionInstallId,
+    pub(super) extension_id: String,
+    pub(super) generation: ExtensionRuntimeGeneration,
+    pub(super) manifest: Manifest,
+    pub(super) root: PathBuf,
+    pub(super) loaded: WebExtensionLoaded,
+    pub(super) channel: ChannelExtension,
+    pub(super) package: scheme::Package,
+    pub(super) permissions: Vec<String>,
+    pub(super) hosts: Vec<String>,
+    pub(super) background: Option<WebView>,
+    pub(super) storage: api::Storage,
+    pub(super) action: action::ActionState,
+    pub(super) alarms: HashMap<String, gtk::glib::SourceId>,
+    pub(super) popup: Option<action::Popup>,
+    /// Tabs the user clicked the extension's action on: `activeTab` lets it
+    /// script them although it has no host permission for them.
+    pub(super) active_tabs: HashSet<zephium_core::ids::ItemId>,
+}
+
+impl Install {
+    pub(super) fn origin(&self) -> String {
+        format!("chrome-extension://{}/", self.extension_id)
+    }
+
+    /// The extension's own views that are not tabs: its background and its
+    /// open popup.
+    pub(super) fn own_views(&self) -> Vec<WebView> {
+        self.background.iter().cloned().chain(self.popup.as_ref().map(|popup| popup.view.clone())).collect()
+    }
+
+    fn prepare(
+        load: &WebExtensionLoad,
+        generation: ExtensionRuntimeGeneration,
+        storage: Option<PathBuf>,
+    ) -> Result<Self, String> {
+        let manifest = Manifest::load(&load.root).map_err(|error| error.to_string())?;
+        let origin = format!("chrome-extension://{}/", load.extension_id);
+        let info = zephium_webext_linux::info::info(&load.extension_id, &origin, &load.root, &manifest);
+        let groups = zephium_webext_linux::content::groups(&load.root, &manifest)?
+            .into_iter()
+            .map(|group| (group.matches, group.exclude_matches, group.js, group.run_at.to_owned(), group.all_frames))
+            .collect();
+        let loaded = WebExtensionLoaded {
+            name: manifest.name().unwrap_or_else(|| load.extension_id.clone()),
+            version: manifest.version().unwrap_or("0").to_owned(),
+        };
+        let package = scheme::Package {
+            root: load.root.clone(),
+            csp: content_security_policy(&manifest),
+            accessible: web_accessible(&manifest),
+            background: background_page(&manifest),
+        };
+        Ok(Self {
+            id: load.install,
+            extension_id: load.extension_id.clone(),
+            generation,
+            root: load.root.clone(),
+            loaded,
+            channel: ChannelExtension {
+                id: load.extension_id.clone(),
+                info,
+                granted: load.match_patterns.clone(),
+                groups,
+            },
+            package,
+            permissions: load.permissions.clone(),
+            hosts: load.match_patterns.clone(),
+            background: None,
+            storage: api::Storage::open(storage)?,
+            action: action::ActionState::from_manifest(&manifest, &load.root),
+            alarms: HashMap::new(),
+            popup: None,
+            active_tabs: HashSet::new(),
+            manifest,
+        })
+    }
+
+    fn stop(&mut self) {
+        for (_, alarm) in self.alarms.drain() {
+            alarm.remove();
+        }
+        if let Some(popup) = self.popup.take() {
+            popup.close();
+        }
+        if let Some(background) = self.background.take() {
+            background.try_close();
+        }
+    }
+}
+
+impl super::EngineHost {
+    pub(crate) fn load_web_extension(&mut self, profile: ProfileId, load: WebExtensionLoad) {
+        let previous = self.linux_stop_install(profile, load.install).map(|install| install.generation);
+        let generation = previous
+            .and_then(|generation| generation.next())
+            .unwrap_or(ExtensionRuntimeGeneration::INITIAL);
+        let storage = self.linux_storage_dir(profile, &load.extension_id);
+        let result = Install::prepare(&load, generation, storage).map(|install| {
+            let loaded = install.loaded.clone();
+            let state = self.linux_extensions.profiles.entry(profile).or_default();
+            state.installs.insert(load.install, install);
+            loaded
+        });
+        self.linux_extensions_sync(profile);
+        self.sink.emit(EngineEvent::WebExtensionSettled { profile, install: load.install, result });
+        self.sink.emit(EngineEvent::ExtensionActionsInvalidated { profile });
+    }
+
+    pub(crate) fn unload_web_extension(&mut self, profile: ProfileId, install: ExtensionInstallId) {
+        self.linux_stop_install(profile, install);
+        self.linux_extensions_sync(profile);
+        self.sink.emit(EngineEvent::ExtensionActionsInvalidated { profile });
+    }
+
+    pub(crate) fn remove_web_extension(&mut self, profile: ProfileId, load: WebExtensionLoad) {
+        self.linux_stop_install(profile, load.install);
+        if let Some(storage) = self.linux_storage_dir(profile, &load.extension_id) {
+            let _ = std::fs::remove_dir_all(storage);
+        }
+        self.linux_extensions_sync(profile);
+        self.sink.emit(EngineEvent::ExtensionActionsInvalidated { profile });
+    }
+
+    pub(crate) fn open_web_extension_options(&mut self, profile: ProfileId, extension_id: &str) {
+        let Some(state) = self.linux_extensions.profiles.get(&profile) else {
+            return;
+        };
+        let Some(install) = state.install(extension_id) else {
+            return;
+        };
+        let Some(page) = install.manifest.options_page() else {
+            return;
+        };
+        let url = format!("{}{}", install.origin(), page.trim_start_matches('/'));
+        self.linux_request_tab(profile, Some(url), true);
+    }
+
+    /// A view of `profile` passed its security configuration: the profile's
+    /// context now serves extension pages and carries the plugin.
+    pub(super) fn linux_extensions_view_ready(&mut self, profile: ProfileId, view: &wry::WebView) {
+        let Some(context) = view.webview().context() else {
+            return;
+        };
+        let state = self.linux_extensions.profiles.entry(profile).or_default();
+        if state.context.is_none() {
+            scheme::register(&context, &state.packages);
+            if let Some(channel) = extension_channel::channel(&context) {
+                channel.set_handler(move |message| {
+                    super::dispatch::best_effort_with(move |host| host.linux_extension_message(profile, message));
+                });
+                state.channel = Some(channel);
+            }
+            state.context = Some(context);
+        }
+        self.linux_extensions_sync(profile);
+    }
+
+    /// Bring the plugin's startup data, the served packages, the background
+    /// views and the navigation grants in line with the loaded installs.
+    fn linux_extensions_sync(&mut self, profile: ProfileId) {
+        let tab_views = self.linux_tab_views(profile);
+        let Some(state) = self.linux_extensions.profiles.get_mut(&profile) else {
+            return;
+        };
+        {
+            let mut packages = state.packages.borrow_mut();
+            packages.clear();
+            for install in state.installs.values() {
+                packages.insert(install.extension_id.clone(), install.package.clone());
+            }
+        }
+        if let Some(channel) = &state.channel {
+            channel.set_extensions(state.installs.values().map(|install| install.channel.clone()).collect());
+            // Processes already running learn the change now; new ones ask.
+            let data = channel.current_data();
+            let own = state.installs.values().flat_map(Install::own_views);
+            for view in tab_views.iter().cloned().chain(own) {
+                extension_channel::configure_page(&view, &data);
+            }
+        }
+        if let (Some(context), Some(channel)) = (&state.context, &state.channel) {
+            for install in state.installs.values_mut().filter(|install| install.background.is_none()) {
+                install.background = start_background(context, channel, install);
+            }
+        }
+        let ids = state.installs.values().map(|install| install.extension_id.clone()).collect();
+        self.linux_extensions.set_navigation(profile, ids);
+    }
+
+    fn linux_stop_install(&mut self, profile: ProfileId, install: ExtensionInstallId) -> Option<Install> {
+        let state = self.linux_extensions.profiles.get_mut(&profile)?;
+        let mut removed = state.installs.remove(&install)?;
+        removed.stop();
+        state.routing.forget_extension(&removed.extension_id);
+        Some(removed)
+    }
+
+    /// Where an extension's `local` and `sync` storage live in its profile.
+    fn linux_storage_dir(&self, profile: ProfileId, extension_id: &str) -> Option<PathBuf> {
+        crate::erasure::prepare_profile_directory(&self.profiles_root, profile)
+            .ok()
+            .map(|profile_dir| profile_dir.join("webext-storage").join(extension_id))
+    }
+}
+
+/// The hidden view an extension's background runs in. Host permissions are
+/// its CORS allowlist, as in Chrome.
+fn start_background(context: &WebContext, channel: &Rc<Channel>, install: &Install) -> Option<WebView> {
+    let path = match install.manifest.background()? {
+        Background::Page(page) => page,
+        Background::Scripts(_) | Background::ServiceWorker { .. } => scheme::BACKGROUND_PATH.trim_start_matches('/').to_owned(),
+    };
+    let view = WebView::with_context(context);
+    let allowlist = cors_allowlist(&install.hosts);
+    view.set_cors_allowlist(&allowlist.iter().map(String::as_str).collect::<Vec<_>>());
+    extension_channel::listen(&view, channel.clone());
+    let url = format!("{}{}", install.origin(), path.trim_start_matches('/'));
+    trace!("background of {} starts at {url}", install.extension_id);
+    // With the trace on, the page's console (script errors, refused loads)
+    // goes to the log too.
+    if std::env::var_os("ZEPHIUM_WEBEXT_TRACE").is_some() {
+        if let Some(settings) = WebViewExt::settings(&view) {
+            settings.set_enable_write_console_messages_to_stdout(true);
+        }
+    }
+    view.connect_load_changed(|view, event| trace!("background {:?}: {event:?}", view.uri()));
+    view.connect_load_failed(|view, _, uri, error| {
+        trace!("background {:?} failed to load {uri}: {error}", view.uri());
+        false
+    });
+    view.connect_web_process_terminated(|view, reason| trace!("background {:?}: web process ended ({reason:?})", view.uri()));
+    view.load_uri(&url);
+    Some(view)
+}
+
+/// Chrome host patterns in the form WebKit's allowlist takes.
+fn cors_allowlist(hosts: &[String]) -> Vec<String> {
+    hosts
+        .iter()
+        .flat_map(|host| match host.as_str() {
+            "<all_urls>" => vec!["*://*/*".to_owned()],
+            other => vec![other.to_owned()],
+        })
+        .collect()
+}
+
+/// The generated page a background without its own page loads. Preparation
+/// put the API layer first in `background.scripts`; a service worker gets it,
+/// and a stand-in for `importScripts`, ahead of the worker's script.
+fn background_page(manifest: &Manifest) -> Option<String> {
+    let compat = format!("/{}/compat.js", zephium_webext::prepare::COMPAT_DIR);
+    let tag = |src: &str, module: bool| {
+        let kind = if module { r#" type="module""# } else { "" };
+        format!(r#"<script src="/{}"{kind}></script>"#, src.trim_start_matches('/'))
+    };
+    let scripts = match manifest.background()? {
+        Background::Page(_) => return None,
+        Background::Scripts(scripts) => scripts.iter().map(|script| tag(script, false)).collect::<Vec<_>>(),
+        Background::ServiceWorker { path, module } => {
+            vec![tag(&compat, false), tag(scheme::WORKER_SHIM_PATH, false), tag(&path, module)]
+        }
+    };
+    Some(format!("<!doctype html><meta charset=\"utf-8\">{}", scripts.concat()))
+}
+
+fn content_security_policy(manifest: &Manifest) -> String {
+    let raw = &manifest.raw()["content_security_policy"];
+    let declared = raw["extension_pages"].as_str().or_else(|| raw.as_str());
+    declared.map(str::to_owned).unwrap_or_else(|| {
+        if manifest.manifest_version() >= 3 {
+            "script-src 'self' 'wasm-unsafe-eval'; object-src 'self';".to_owned()
+        } else {
+            "script-src 'self' blob: filesystem:; object-src 'self';".to_owned()
+        }
+    })
+}
+
+/// `web_accessible_resources` in either manifest version's shape.
+fn web_accessible(manifest: &Manifest) -> Vec<String> {
+    let Some(entries) = manifest.web_accessible_resources().and_then(|value| value.as_array()) else {
+        return Vec::new();
+    };
+    entries
+        .iter()
+        .flat_map(|entry| match entry {
+            serde_json::Value::String(path) => vec![path.clone()],
+            object => object["resources"]
+                .as_array()
+                .map(|resources| resources.iter().filter_map(|value| value.as_str().map(str::to_owned)).collect())
+                .unwrap_or_default(),
+        })
+        .collect()
+}
diff --git a/crates/zephium-engine/src/host/webext_linux/routing.rs b/crates/zephium-engine/src/host/webext_linux/routing.rs
new file mode 100644
index 00000000..275f751c
--- /dev/null
+++ b/crates/zephium-engine/src/host/webext_linux/routing.rs
@@ -0,0 +1,263 @@
+//! Messages between an extension's contexts: one-off messages and their
+//! answers, long-lived ports, and the events the browser raises.
+
+use std::collections::HashMap;
+use std::hash::Hash;
+
+use serde_json::{json, Value};
+use webkit2gtk::WebView;
+use zephium_core::ids::ProfileId;
+
+use crate::platform::imp::extension_channel::{self, Message};
+
+/// Chrome's answer when nobody listens.
+const NO_RECEIVER: &str = "Could not establish connection. Receiving end does not exist.";
+
+#[derive(Default)]
+pub(super) struct Routing {
+    next: u64,
+    waiting: HashMap<u64, Waiting>,
+    ports: HashMap<u64, Port>,
+    /// Chrome's tab and window IDs are small integers; Zephium's are ULIDs
+    /// and 64-bit numbers.
+    pub(super) tabs: IdMap<zephium_core::ids::ItemId>,
+    pub(super) windows: IdMap<zephium_core::ids::WindowId>,
+}
+
+/// A one-off message waiting for its answer. Each world that got it answers
+/// once, with a value or declining; the first value wins.
+struct Waiting {
+    extension_id: String,
+    request: u64,
+    sender: Message,
+    views_left: usize,
+    listeners: u32,
+    declined: u32,
+}
+
+/// Where a context lives: its view and its frame (0 for every frame).
+#[derive(Clone, PartialEq)]
+pub(super) struct Endpoint {
+    pub(super) view: WebView,
+    pub(super) frame: u64,
+}
+
+struct Port {
+    extension_id: String,
+    opener: Endpoint,
+    receivers: Vec<Endpoint>,
+}
+
+pub(super) struct IdMap<T> {
+    numbers: HashMap<T, i64>,
+    items: HashMap<i64, T>,
+    next: i64,
+}
+
+impl<T> Default for IdMap<T> {
+    fn default() -> Self {
+        Self { numbers: HashMap::new(), items: HashMap::new(), next: 1 }
+    }
+}
+
+impl<T: Copy + Eq + Hash> IdMap<T> {
+    pub(super) fn number(&mut self, item: T) -> i64 {
+        if let Some(number) = self.numbers.get(&item) {
+            return *number;
+        }
+        let number = self.next;
+        self.next += 1;
+        self.numbers.insert(item, number);
+        self.items.insert(number, item);
+        number
+    }
+
+    pub(super) fn item(&self, number: i64) -> Option<T> {
+        self.items.get(&number).copied()
+    }
+}
+
+impl Routing {
+    fn token(&mut self) -> u64 {
+        self.next += 1;
+        self.next
+    }
+
+    pub(super) fn forget_extension(&mut self, extension_id: &str) {
+        self.ports.retain(|_, port| port.extension_id != extension_id);
+        let gone: Vec<u64> =
+            self.waiting.iter().filter(|(_, waiting)| waiting.extension_id == extension_id).map(|(token, _)| *token).collect();
+        for token in gone {
+            if let Some(waiting) = self.waiting.remove(&token) {
+                waiting.sender.reply(&error(waiting.request, NO_RECEIVER));
+            }
+        }
+    }
+}
+
+pub(super) fn ok(request: u64, value: Value) -> String {
+    json!({ "id": request, "ok": value }).to_string()
+}
+
+pub(super) fn error(request: u64, message: &str) -> String {
+    json!({ "id": request, "error": message }).to_string()
+}
+
+/// Raise `event` with `args` in `extension_id`'s worlds at `endpoint`.
+pub(super) fn raise(endpoint: &Endpoint, extension_id: &str, event: &str, args: Value) {
+    let body = json!({ "event": event, "args": args }).to_string();
+    extension_channel::raise(&endpoint.view, extension_id, endpoint.frame, &body, |_| {});
+}
+
+impl super::super::EngineHost {
+    /// Deliver a one-off message to `targets`; the sender's request is
+    /// answered when a receiver answers, or when none will.
+    pub(super) fn linux_send_message(
+        &mut self,
+        profile: ProfileId,
+        sender: Message,
+        request: u64,
+        message: Value,
+        sender_info: Value,
+        targets: Vec<Endpoint>,
+    ) {
+        let Some(state) = self.linux_extensions.profiles.get_mut(&profile) else {
+            return sender.reply(&error(request, NO_RECEIVER));
+        };
+        if targets.is_empty() {
+            return sender.reply(&error(request, NO_RECEIVER));
+        }
+        let extension_id = sender.extension_id.clone();
+        super::trace!("{extension_id} sends a message to {} context(s)", targets.len());
+        let token = state.routing.token();
+        let body = json!({ "event": "runtime.onMessage", "args": [message, sender_info], "reply": token }).to_string();
+        state.routing.waiting.insert(
+            token,
+            Waiting { extension_id: extension_id.clone(), request, sender, views_left: targets.len(), listeners: 0, declined: 0 },
+        );
+        for target in targets {
+            extension_channel::raise(&target.view, &extension_id, target.frame, &body, move |count| {
+                super::super::dispatch::best_effort_with(move |host| host.linux_message_counted(profile, token, count));
+            });
+        }
+    }
+
+    fn linux_message_counted(&mut self, profile: ProfileId, token: u64, count: u32) {
+        super::trace!("message {token}: a context had {count} listener(s)");
+        let Some(waiting) = self.linux_waiting(profile, token) else {
+            return;
+        };
+        waiting.views_left = waiting.views_left.saturating_sub(1);
+        waiting.listeners += count;
+        self.linux_settle_if_done(profile, token);
+    }
+
+    /// `runtime.answer`: a receiving world's answer, or its declining.
+    pub(super) fn linux_message_answered(&mut self, profile: ProfileId, token: u64, value: Value, answered: bool) {
+        if answered {
+            if let Some(waiting) = self.linux_extensions.profiles.get_mut(&profile).and_then(|state| state.routing.waiting.remove(&token)) {
+                waiting.sender.reply(&ok(waiting.request, value));
+            }
+            return;
+        }
+        if let Some(waiting) = self.linux_waiting(profile, token) {
+            waiting.declined += 1;
+        }
+        self.linux_settle_if_done(profile, token);
+    }
+
+    fn linux_waiting(&mut self, profile: ProfileId, token: u64) -> Option<&mut Waiting> {
+        self.linux_extensions.profiles.get_mut(&profile)?.routing.waiting.get_mut(&token)
+    }
+
+    fn linux_settle_if_done(&mut self, profile: ProfileId, token: u64) {
+        let Some(state) = self.linux_extensions.profiles.get_mut(&profile) else {
+            return;
+        };
+        let done = state
+            .routing
+            .waiting
+            .get(&token)
+            .is_some_and(|waiting| waiting.views_left == 0 && waiting.declined >= waiting.listeners);
+        if !done {
+            return;
+        }
+        let Some(waiting) = state.routing.waiting.remove(&token) else {
+            return;
+        };
+        if waiting.listeners == 0 {
+            waiting.sender.reply(&error(waiting.request, NO_RECEIVER));
+        } else {
+            // Every listener declined: the sender's callback runs with nothing.
+            waiting.sender.reply(&json!({ "id": waiting.request }).to_string());
+        }
+    }
+
+    /// Open a port from `opener` to `receivers`; answers with its number.
+    pub(super) fn linux_connect(
+        &mut self,
+        profile: ProfileId,
+        extension_id: &str,
+        opener: Endpoint,
+        name: &str,
+        sender_info: Value,
+        receivers: Vec<Endpoint>,
+    ) -> Result<Value, String> {
+        if receivers.is_empty() {
+            return Err(NO_RECEIVER.into());
+        }
+        let state = self.linux_extensions.profiles.get_mut(&profile).ok_or(NO_RECEIVER)?;
+        let id = state.routing.token();
+        for receiver in &receivers {
+            raise(receiver, extension_id, "runtime.onConnect", json!([id, name, sender_info]));
+        }
+        state.routing.ports.insert(id, Port { extension_id: extension_id.to_owned(), opener, receivers });
+        Ok(json!(id))
+    }
+
+    pub(super) fn linux_port_post(&mut self, profile: ProfileId, from: &Endpoint, id: u64, message: Value) -> Result<Value, String> {
+        let state = self.linux_extensions.profiles.get(&profile).ok_or("no such port")?;
+        let port = state.routing.ports.get(&id).ok_or("Attempting to use a disconnected port object")?;
+        for target in port.other_side(from) {
+            raise(&target, &port.extension_id, "port.message", json!([id, message.clone()]));
+        }
+        Ok(Value::Null)
+    }
+
+    pub(super) fn linux_port_disconnect(&mut self, profile: ProfileId, from: &Endpoint, id: u64) -> Result<Value, String> {
+        let state = self.linux_extensions.profiles.get_mut(&profile).ok_or("no such port")?;
+        if let Some(port) = state.routing.ports.remove(&id) {
+            for target in port.other_side(from) {
+                raise(&target, &port.extension_id, "port.disconnect", json!([id, Value::Null]));
+            }
+        }
+        Ok(Value::Null)
+    }
+}
+
+impl Port {
+    /// The ends a message from `from` goes to.
+    fn other_side(&self, from: &Endpoint) -> Vec<Endpoint> {
+        let from_opener = from.view == self.opener.view && (from.frame == self.opener.frame || self.opener.frame == 0);
+        if from_opener {
+            self.receivers.clone()
+        } else {
+            vec![self.opener.clone()]
+        }
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::IdMap;
+
+    #[test]
+    fn numbers_are_stable_and_reversible() {
+        let mut map = IdMap::<u64>::default();
+        let first = map.number(900);
+        assert_eq!(map.number(900), first);
+        assert_ne!(map.number(901), first);
+        assert_eq!(map.item(first), Some(900));
+        assert_eq!(map.item(999), None);
+    }
+}
diff --git a/crates/zephium-engine/src/host/webext_linux/scheme.rs b/crates/zephium-engine/src/host/webext_linux/scheme.rs
new file mode 100644
index 00000000..543e140f
--- /dev/null
+++ b/crates/zephium-engine/src/host/webext_linux/scheme.rs
@@ -0,0 +1,197 @@
+//! Extension pages: `chrome-extension://<id>/<path>`, and `moz-extension://`
+//! for the same files, served from the prepared package.
+//!
+//! A view of the extension's own origin gets every file. Anything else (a web
+//! page embedding an extension frame or image) gets only what the manifest
+//! lists in `web_accessible_resources`, as in Chrome.
+
+use std::cell::RefCell;
+use std::collections::HashMap;
+use std::path::{Component, Path, PathBuf};
+use std::rc::Rc;
+
+use webkit2gtk::{
+    SecurityManagerExt, URISchemeRequest, URISchemeRequestExt, URISchemeResponse, URISchemeResponseExt, WebContext,
+    WebContextExt, WebViewExt,
+};
+
+pub(super) const SCHEMES: [&str; 2] = ["chrome-extension", "moz-extension"];
+/// The page a background without its own page loads: the API layer, then the
+/// manifest's scripts or service worker.
+pub(super) const BACKGROUND_PATH: &str = "/_zephium_/background.html";
+/// Loaded ahead of a service worker run in that page: `importScripts` adds the
+/// named scripts to the page while it is still being parsed, so they run in
+/// order before the rest of the worker.
+pub(super) const WORKER_SHIM_PATH: &str = "/_zephium_/worker-shim.js";
+const WORKER_SHIM: &str = r#"globalThis.importScripts = (...urls) => {
+  for (const url of urls) document.write(`<script src="${new URL(url, document.baseURI).href}"><\/script>`);
+};"#;
+
+/// What the scheme handler needs of one loaded extension.
+#[derive(Clone)]
+pub(super) struct Package {
+    pub(super) root: PathBuf,
+    pub(super) csp: String,
+    pub(super) accessible: Vec<String>,
+    pub(super) background: Option<String>,
+}
+
+pub(super) type Packages = Rc<RefCell<HashMap<String, Package>>>;
+
+/// Serve `packages` on `context`; once per context.
+pub(super) fn register(context: &WebContext, packages: &Packages) {
+    for scheme in SCHEMES {
+        let packages = packages.clone();
+        context.register_uri_scheme(scheme, move |request| serve(&packages.borrow(), request));
+        if let Some(security) = context.security_manager() {
+            security.register_uri_scheme_as_secure(scheme);
+            security.register_uri_scheme_as_cors_enabled(scheme);
+        }
+    }
+}
+
+fn serve(packages: &HashMap<String, Package>, request: &URISchemeRequest) {
+    let uri = request.uri().map(|uri| uri.to_string()).unwrap_or_default();
+    let Some((origin, extension_id, path)) = split(&uri) else {
+        return fail(request, "not an extension address");
+    };
+    let Some(package) = packages.get(extension_id) else {
+        return fail(request, "no such extension");
+    };
+    let own = request
+        .web_view()
+        .and_then(|view| view.uri())
+        .is_some_and(|requester| requester.starts_with(&origin));
+    super::trace!("request {uri} (from the extension itself: {own})");
+    if path == WORKER_SHIM_PATH && own {
+        return respond(request, WORKER_SHIM.as_bytes().to_vec(), "text/javascript", None);
+    }
+    if path == BACKGROUND_PATH {
+        return match (&package.background, own) {
+            (Some(page), true) => respond(request, page.as_bytes().to_vec(), "text/html", Some(&package.csp)),
+            _ => fail(request, "not found"),
+        };
+    }
+    if !own && !package.accessible.iter().any(|pattern| glob(pattern.trim_start_matches('/'), path.trim_start_matches('/'))) {
+        return fail(request, "not web accessible");
+    }
+    match read(&package.root, path) {
+        Some(bytes) => {
+            let mime = mime(path);
+            let csp = (mime == "text/html").then_some(package.csp.as_str());
+            respond(request, bytes, mime, csp);
+        }
+        None => fail(request, "not found"),
+    }
+}
+
+/// `scheme://id/path?query#fragment` -> (`scheme://id/`, `id`, `/path`); the
+/// bare origin is its `/index.html`.
+fn split(uri: &str) -> Option<(String, &str, &str)> {
+    let (scheme, rest) = uri.split_once("://")?;
+    if !SCHEMES.contains(&scheme) {
+        return None;
+    }
+    let (host, path) = match rest.find('/') {
+        Some(slash) => (&rest[..slash], &rest[slash..]),
+        None => (rest, "/"),
+    };
+    let path = path.split(['?', '#']).next().unwrap_or("/");
+    let path = if path == "/" { "/index.html" } else { path };
+    Some((format!("{scheme}://{host}/"), host, path))
+}
+
+/// A file of the package, refusing anything that would leave it.
+fn read(root: &Path, path: &str) -> Option<Vec<u8>> {
+    let relative = Path::new(path.trim_start_matches('/'));
+    if relative.components().any(|part| !matches!(part, Component::Normal(_))) {
+        return None;
+    }
+    let file = root.join(relative).canonicalize().ok()?;
+    if !file.starts_with(root.canonicalize().ok()?) {
+        return None;
+    }
+    std::fs::read(file).ok()
+}
+
+fn respond(request: &URISchemeRequest, bytes: Vec<u8>, mime: &str, csp: Option<&str>) {
+    let length = bytes.len() as i64;
+    let stream = gtk::gio::MemoryInputStream::from_bytes(&gtk::glib::Bytes::from_owned(bytes));
+    let response = URISchemeResponse::new(&stream, length);
+    response.set_content_type(mime);
+    // These headers replace the response's own, so the type goes in here too:
+    // with nosniff, WebKit runs no script whose header lacks a script type.
+    let headers = soup::MessageHeaders::new(soup::MessageHeadersType::Response);
+    headers.append("Content-Type", mime);
+    if let Some(csp) = csp {
+        headers.append("Content-Security-Policy", csp);
+    }
+    headers.append("X-Content-Type-Options", "nosniff");
+    response.set_http_headers(headers);
+    request.finish_with_response(&response);
+}
+
+fn fail(request: &URISchemeRequest, reason: &str) {
+    super::trace!("refused {:?}: {reason}", request.uri());
+    let mut error = gtk::glib::Error::new(gtk::gio::IOErrorEnum::NotFound, reason);
+    request.finish_error(&mut error);
+}
+
+fn mime(path: &str) -> &'static str {
+    match path.rsplit('.').next().unwrap_or_default().to_ascii_lowercase().as_str() {
+        "html" | "htm" => "text/html",
+        "js" | "mjs" => "text/javascript",
+        "css" => "text/css",
+        "json" => "application/json",
+        "png" => "image/png",
+        "jpg" | "jpeg" => "image/jpeg",
+        "gif" => "image/gif",
+        "svg" => "image/svg+xml",
+        "webp" => "image/webp",
+        "ico" => "image/x-icon",
+        "woff" => "font/woff",
+        "woff2" => "font/woff2",
+        "ttf" => "font/ttf",
+        "wasm" => "application/wasm",
+        "txt" => "text/plain",
+        _ => "application/octet-stream",
+    }
+}
+
+/// `web_accessible_resources` globs: `*` matches any run of characters.
+fn glob(pattern: &str, text: &str) -> bool {
+    match pattern.split_once('*') {
+        None => pattern == text,
+        Some((head, tail)) => {
+            text.starts_with(head) && (0..=text.len() - head.len()).any(|skip| glob(tail, &text[head.len() + skip..]))
+        }
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn addresses_split_into_origin_id_and_path() {
+        let (origin, id, path) = split("chrome-extension://abc/popup.html?x=1#y").unwrap();
+        assert_eq!((origin.as_str(), id, path), ("chrome-extension://abc/", "abc", "/popup.html"));
+        assert_eq!(split("moz-extension://abc").unwrap().2, "/index.html");
+        assert!(split("https://abc/").is_none());
+    }
+
+    #[test]
+    fn accessible_globs() {
+        assert!(glob("images/*", "images/a/b.png"));
+        assert!(glob("*.css", "x.css"));
+        assert!(!glob("images/*", "secret.js"));
+    }
+
+    #[test]
+    fn files_cannot_leave_the_package() {
+        let dir = tempfile::tempdir().unwrap();
+        std::fs::write(dir.path().join("a.js"), "1").unwrap();
+        assert_eq!(read(dir.path(), "/a.js").as_deref(), Some(&b"1"[..]));
+        assert!(read(dir.path(), "/../etc/passwd").is_none());
+    }
+}
