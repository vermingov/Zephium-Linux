+            let styles = (!group.css.is_empty()).then(|| Group {
+                js: vec![style_inserter(&group.css)],
+                css: Vec::new(),
+                run_at: "document_start",
+                ..group.clone()
+            });
+            let scripts = (!group.js.is_empty()).then(|| Group { css: Vec::new(), ..group });
+            styles.into_iter().chain(scripts)
+        })
+        .collect()
+}
