{
  "productName": "app.zephium",
  "app": {
    "enableGTKAppId": true,
    "windows": [
      {
        "label": "main",
        "create": false,
        "title": "Zephium",
        "width": 1200,
        "height": 800,
        "minWidth": 680,
        "minHeight": 480,
        "decorations": false,
        "transparent": true
      }
    ]
  },
  "bundle": {
    "linux": {
      "deb": {
        "desktopTemplate": "linux/zephium.desktop.hbs",
        "files": {
          "/usr/lib/app.zephium/webext/libzephium_webext_process.so": "linux/webext/libzephium_webext_process.so"
        }
      },
      "rpm": {
        "desktopTemplate": "linux/zephium.desktop.hbs"
      }
    }
  },
  "build": {
    "beforeBuildCommand": "pnpm --dir ../frame build && sh linux/build-webext-plugin.sh"
  }
}
